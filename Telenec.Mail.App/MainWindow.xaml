<Window x:Class="Telenec.Mail.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mail="clr-namespace:Telenec.Mail.App.Services.Mail"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="{Binding ApplicationTitle}"
        Width="1400"
        Height="820"
        MinWidth="1100"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Surface.Background}"
        Foreground="{StaticResource Text.Primary}"
        FontFamily="{StaticResource Typography.FontFamily}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- LINKE NAVIGATION -->

        <Border
            Grid.Column="0"
            Background="{StaticResource Navigation.Background}">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel
                    Grid.Row="0"
                    Margin="22,22,22,18">

                    <Image
                        Source="/Assets/Brand/TelenecLogo.png"
                        Height="72"
                        HorizontalAlignment="Left"
                        Stretch="Uniform" />

                    <TextBlock
                        Text="MAIL"
                        Margin="4,5,0,0"
                        Foreground="{StaticResource Navigation.TextSecondary}"
                        FontSize="12"
                        FontWeight="SemiBold" />

                </StackPanel>

                <Border
                    Grid.Row="1"
                    Margin="16,0,16,18"
                    Padding="12,9"
                    CornerRadius="6"
                    Background="{StaticResource Navigation.Selected}">

                    <StackPanel Orientation="Horizontal">

                        <Ellipse
                            Width="8"
                            Height="8"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center">

                            <Ellipse.Style>

                                <Style TargetType="Ellipse">

                                    <Setter
                                        Property="Fill"
                                        Value="{StaticResource Status.Information}" />

                                    <Style.Triggers>

                                        <DataTrigger
                                            Binding="{Binding ConnectionState}"
                                            Value="{x:Static mail:MailConnectionState.Connected}">
                                            <Setter
                                                Property="Fill"
                                                Value="{StaticResource Status.Success}" />
                                        </DataTrigger>

                                        <DataTrigger
                                            Binding="{Binding ConnectionState}"
                                            Value="{x:Static mail:MailConnectionState.Offline}">
                                            <Setter
                                                Property="Fill"
                                                Value="{StaticResource Status.Warning}" />
                                        </DataTrigger>

                                        <DataTrigger
                                            Binding="{Binding ConnectionState}"
                                            Value="{x:Static mail:MailConnectionState.AuthenticationRequired}">
                                            <Setter
                                                Property="Fill"
                                                Value="{StaticResource Status.Warning}" />
                                        </DataTrigger>

                                        <DataTrigger
                                            Binding="{Binding ConnectionState}"
                                            Value="{x:Static mail:MailConnectionState.SecurityError}">
                                            <Setter
                                                Property="Fill"
                                                Value="{StaticResource Status.Error}" />
                                        </DataTrigger>

                                        <DataTrigger
                                            Binding="{Binding ConnectionState}"
                                            Value="{x:Static mail:MailConnectionState.Error}">
                                            <Setter
                                                Property="Fill"
                                                Value="{StaticResource Status.Error}" />
                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>

                            </Ellipse.Style>

                        </Ellipse>

                        <TextBlock
                            Text="{Binding ConnectionStatusText}"
                            Foreground="{StaticResource Navigation.TextSecondary}"
                            FontSize="12"
                            VerticalAlignment="Center" />

                    </StackPanel>

                </Border>

                <Button
                    Grid.Row="2"
                    Height="42"
                    Margin="16,0,16,18"
                    Cursor="Hand"
                    ToolTip="Neue E-Mail verfassen"
                    Style="{StaticResource Button.Primary}"
                    Click="ComposeMailButton_OnClick">

                    <StackPanel
                        Orientation="Horizontal"
                        HorizontalAlignment="Center">

                        <TextBlock
                            Text="&#xE70F;"
                            Margin="0,0,9,0"
                            FontFamily="Segoe Fluent Icons"
                            FontSize="16"
                            VerticalAlignment="Center" />

                        <TextBlock
                            Text="Neue E-Mail"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center" />

                    </StackPanel>

                </Button>

                <ListBox
                    x:Name="FolderListBox"
                    Grid.Row="3"
                    ItemsSource="{Binding MailFolders}"
                    SelectedItem="{Binding SelectedFolder, Mode=TwoWay}"
                    Style="{StaticResource Navigation.FolderList}"
                    ItemContainerStyle="{StaticResource Navigation.FolderItem}"
                    AllowDrop="True"
                    DragOver="FolderListBox_OnDragOver"
                    Drop="FolderListBox_OnDrop">

                    <ListBox.ItemTemplate>

                        <DataTemplate>

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    x:Name="FolderNameText"
                                    Grid.Column="0"
                                    Text="{Binding DisplayName}"
                                    Style="{StaticResource Navigation.ItemText}" />

                                <Border
                                    x:Name="UnreadBadge"
                                    Grid.Column="1"
                                    MinWidth="26"
                                    Height="22"
                                    Padding="7,0"
                                    CornerRadius="11"
                                    Background="{StaticResource Brand.Primary}"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed">

                                    <TextBlock
                                        Text="{Binding UnreadCount}"
                                        Foreground="White"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />

                                </Border>

                            </Grid>

                            <DataTemplate.Triggers>

                                <DataTrigger
                                    Binding="{Binding HasUnreadCount}"
                                    Value="True">
                                    <Setter
                                        TargetName="UnreadBadge"
                                        Property="Visibility"
                                        Value="Visible" />
                                </DataTrigger>

                                <DataTrigger
                                    Binding="{Binding IsSelected,
                                        RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}"
                                    Value="True">

                                    <Setter
                                        TargetName="FolderNameText"
                                        Property="Margin"
                                        Value="16,0,0,0" />

                                    <Setter
                                        TargetName="FolderNameText"
                                        Property="FontWeight"
                                        Value="SemiBold" />

                                </DataTrigger>

                            </DataTemplate.Triggers>

                        </DataTemplate>

                    </ListBox.ItemTemplate>

                </ListBox>

                <Border
                    Grid.Row="4"
                    Padding="20,18"
                    BorderBrush="{StaticResource Navigation.Selected}"
                    BorderThickness="0,1,0,0">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>

                            <TextBlock
                                x:Name="AccountEmailText"
                                Text="Telenec-Konto"
                                Foreground="{StaticResource Navigation.Text}"
                                FontSize="12"
                                FontWeight="SemiBold"
                                TextTrimming="CharacterEllipsis" />

                            <TextBlock
                                Text="Telenec Mail"
                                Margin="0,3,0,0"
                                Foreground="{StaticResource Navigation.TextSecondary}"
                                FontSize="11" />

                        </StackPanel>

                        <Button
                            x:Name="AccountMenuButton"
                            Grid.Column="1"
                            Width="34"
                            Height="34"
                            Margin="10,0,0,0"
                            Padding="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            ToolTip="Kontoeinstellungen"
                            Click="AccountMenuButton_OnClick">

                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem
                                        Header="Konto abmelden"
                                        Click="LogoutMenuItem_OnClick" />
                                </ContextMenu>
                            </Button.ContextMenu>

                            <TextBlock
                                Text="&#xE713;"
                                FontFamily="Segoe Fluent Icons"
                                Foreground="{StaticResource Navigation.TextSecondary}"
                                FontSize="18"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />

                        </Button>

                    </Grid>

                </Border>

            </Grid>

        </Border>

        <!-- NACHRICHTENLISTE -->

        <Border
            Grid.Column="1"
            Background="{StaticResource Surface.Card}"
            BorderBrush="{StaticResource Border.Default}"
            BorderThickness="0,0,1,0">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid
                    Grid.Row="0"
                    Margin="22,22,22,14">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>

                        <TextBlock
                            Text="{Binding SelectedFolder.DisplayName}"
                            FontSize="24"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource Text.Primary}" />

                        <TextBlock
                            Text="{Binding SelectedFolder.HeaderSubtitle}"
                            Margin="0,4,0,0"
                            FontSize="12"
                            Foreground="{StaticResource Text.Secondary}" />

                    </StackPanel>

                    <Button
                        x:Name="RefreshButton"
                        Grid.Column="1"
                        Width="36"
                        Height="36"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        ToolTip="Postfach aktualisieren"
                        Click="RefreshButton_OnClick">

                        <TextBlock
                            Text="&#xE72C;"
                            FontFamily="Segoe Fluent Icons"
                            FontSize="18"
                            Foreground="{StaticResource Text.Secondary}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />

                    </Button>

                </Grid>

                <Border
                    Grid.Row="1"
                    Margin="18,0,18,14"
                    Height="38"
                    Background="{StaticResource Surface.Background}"
                    BorderBrush="{StaticResource Border.Default}"
                    BorderThickness="1"
                    CornerRadius="6">

                    <Grid Margin="12,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Text="&#xE721;"
                            FontFamily="Segoe Fluent Icons"
                            FontSize="15"
                            Foreground="{StaticResource Text.Secondary}"
                            VerticalAlignment="Center" />

                        <TextBlock
                            Grid.Column="1"
                            Margin="9,0,0,0"
                            Text="E-Mails durchsuchen"
                            FontSize="13"
                            Foreground="{StaticResource Text.Muted}"
                            VerticalAlignment="Center" />

                    </Grid>

                </Border>

                <ListBox
                    x:Name="MessageListBox"
                    Grid.Row="2"
                    ItemsSource="{Binding Messages}"
                    SelectedItem="{Binding SelectedMessage, Mode=TwoWay}"
                    SelectionMode="Extended"
                    Style="{StaticResource MailList.MessageList}"
                    ItemContainerStyle="{StaticResource MailList.MessageItem}"
                    PreviewMouseLeftButtonDown="MessageListBox_OnPreviewMouseLeftButtonDown"
                    PreviewMouseMove="MessageListBox_OnPreviewMouseMove">

                    <ListBox.ItemTemplate>

                        <DataTemplate>

                            <StackPanel>

                                <StackPanel.ContextMenu>

                                    <ContextMenu
                                        DataContext="{Binding PlacementTarget.DataContext,
                                            RelativeSource={RelativeSource Self}}"
                                        Opened="MessageContextMenu_OnOpened">

                                        <MenuItem
                                            Header="Antworten"
                                            Click="ReplyMenuItem_OnClick" />

                                        <MenuItem
                                            Header="Allen antworten"
                                            Click="ReplyAllMenuItem_OnClick" />

                                        <MenuItem
                                            Header="Weiterleiten"
                                            Click="ForwardMenuItem_OnClick" />

                                        <Separator />

                                        <MenuItem
                                            Header="Als ungelesen markieren"
                                            IsEnabled="{Binding CanMarkAsUnread}"
                                            Click="MarkAsUnreadMenuItem_OnClick" />

                                        <Separator />

                                        <MenuItem
                                            Header="Löschen"
                                            Tag="MessageAction"
                                            Click="DeleteMenuItem_OnClick" />

                                    </ContextMenu>

                                </StackPanel.ContextMenu>

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel
                                        Grid.Column="0"
                                        Orientation="Horizontal">

                                        <Ellipse
                                            x:Name="UnreadIndicator"
                                            Width="7"
                                            Height="7"
                                            Margin="0,0,8,0"
                                            Fill="{StaticResource Brand.Primary}"
                                            VerticalAlignment="Center"
                                            Visibility="Collapsed" />

                                        <TextBlock
                                            x:Name="SenderText"
                                            Text="{Binding Sender}"
                                            FontSize="13"
                                            Foreground="{StaticResource Text.Primary}" />

                                    </StackPanel>

                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{Binding DisplayTime}"
                                        FontSize="11"
                                        Foreground="{StaticResource Text.Secondary}" />

                                </Grid>

                                <TextBlock
                                    x:Name="SubjectText"
                                    Margin="0,7,0,0"
                                    Text="{Binding Subject}"
                                    FontSize="14"
                                    Foreground="{StaticResource Text.Primary}" />

                                <TextBlock
                                    Margin="0,5,0,0"
                                    Text="{Binding Preview}"
                                    FontSize="12"
                                    Foreground="{StaticResource Text.Secondary}"
                                    TextTrimming="CharacterEllipsis" />

                            </StackPanel>

                            <DataTemplate.Triggers>

                                <DataTrigger
                                    Binding="{Binding IsUnread}"
                                    Value="True">

                                    <Setter
                                        TargetName="UnreadIndicator"
                                        Property="Visibility"
                                        Value="Visible" />

                                    <Setter
                                        TargetName="SenderText"
                                        Property="FontWeight"
                                        Value="SemiBold" />

                                    <Setter
                                        TargetName="SubjectText"
                                        Property="FontWeight"
                                        Value="SemiBold" />

                                </DataTrigger>

                            </DataTemplate.Triggers>

                        </DataTemplate>

                    </ListBox.ItemTemplate>

                </ListBox>

            </Grid>

        </Border>

        <!-- LESEBEREICH -->

        <Border
            Grid.Column="2"
            Background="{StaticResource Surface.Card}">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="1" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid
                    Grid.Row="0"
                    Margin="32,26,32,22">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="0,0,12,0"
                        Text="{Binding SelectedMessage.Subject}"
                        FontSize="25"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource Text.Primary}"
                        TextWrapping="Wrap" />

                    <Button
                        x:Name="DeleteSelectedMessageButton"
                        Grid.Row="0"
                        Grid.Column="1"
                        Width="36"
                        Height="36"
                        Margin="12,0,0,0"
                        Padding="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Cursor="Hand"
                        ToolTip="{Binding MessageActionToolTip}"
                        Click="DeleteSelectedMessageButton_OnClick">

                        <Button.Style>

                            <Style TargetType="Button">

                                <Setter
                                    Property="Background"
                                    Value="Transparent" />

                                <Setter
                                    Property="BorderThickness"
                                    Value="0" />

                                <Setter
                                    Property="IsEnabled"
                                    Value="True" />

                                <Style.Triggers>

                                    <DataTrigger
                                        Binding="{Binding SelectedMessage}"
                                        Value="{x:Null}">
                                        <Setter
                                            Property="IsEnabled"
                                            Value="False" />
                                    </DataTrigger>

                                    <DataTrigger
                                        Binding="{Binding IsLoading}"
                                        Value="True">
                                        <Setter
                                            Property="IsEnabled"
                                            Value="False" />
                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>

                        </Button.Style>

                        <TextBlock
                            Text="{Binding MessageActionGlyph}"
                            FontFamily="Segoe Fluent Icons"
                            FontSize="18"
                            Foreground="{StaticResource Text.Secondary}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />

                    </Button>

                    <Border
                        Grid.Row="1"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Margin="0,14,0,0"
                        Padding="12,7"
                        HorizontalAlignment="Left"
                        CornerRadius="5"
                        Background="{StaticResource Status.Error}">

                        <Border.Style>

                            <Style TargetType="Border">

                                <Setter
                                    Property="Visibility"
                                    Value="Collapsed" />

                                <Style.Triggers>

                                    <DataTrigger
                                        Binding="{Binding SelectedMessage.HasSmimeSignature}"
                                        Value="True">

                                        <Setter
                                            Property="Visibility"
                                            Value="Visible" />

                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>

                        </Border.Style>

                        <StackPanel
                            Orientation="Horizontal">

                            <TextBlock
                                Text="&#xE72E;"
                                Margin="0,0,8,0"
                                FontFamily="Segoe Fluent Icons"
                                FontSize="15"
                                Foreground="White"
                                VerticalAlignment="Center" />

                            <TextBlock
                                Text="Digital signiert (S/MIME) · Signatur noch nicht geprüft"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="White"
                                VerticalAlignment="Center" />

                        </StackPanel>

                    </Border>

                    <Grid
                        Grid.Row="2"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Margin="0,16,0,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Width="40"
                            Height="40"
                            CornerRadius="20"
                            Background="{StaticResource Brand.Primary}">

                            <TextBlock
                                Text="{Binding SelectedMessage.SenderInitial}"
                                Foreground="White"
                                FontSize="17"
                                FontWeight="SemiBold"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />

                        </Border>

                        <StackPanel
                            Grid.Column="1"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center">

                            <TextBlock
                                Text="{Binding SelectedMessage.Sender}"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource Text.Primary}" />

                            <TextBlock
                                Margin="0,3,0,0"
                                Text="{Binding SelectedMessage.AddressLine}"
                                FontSize="11"
                                Foreground="{StaticResource Text.Secondary}"
                                TextTrimming="CharacterEllipsis" />

                        </StackPanel>

                        <TextBlock
                            Grid.Column="2"
                            Text="{Binding SelectedMessage.DisplayDateTime}"
                            FontSize="11"
                            Foreground="{StaticResource Text.Secondary}"
                            VerticalAlignment="Center"
                            Margin="18,0,0,0" />

                    </Grid>

                    <!-- SICHTBARE MAILAKTIONEN -->

                    <StackPanel
                        Grid.Row="3"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Margin="56,18,0,0"
                        Orientation="Horizontal">

                        <Button
                            Width="110"
                            Height="36"
                            Cursor="Hand"
                            ToolTip="Auf diese Nachricht antworten (Strg+R)"
                            Click="ReplySelectedMessageButton_OnClick">

                            <Button.Style>

                                <Style
                                    TargetType="Button"
                                    BasedOn="{StaticResource Button.Primary}">

                                    <Style.Triggers>

                                        <DataTrigger
                                            Binding="{Binding SelectedMessage}"
                                            Value="{x:Null}">

                                            <Setter
                                                Property="IsEnabled"
                                                Value="False" />

                                        </DataTrigger>

                                        <DataTrigger
                                            Binding="{Binding IsLoading}"
                                            Value="True">

                                            <Setter
                                                Property="IsEnabled"
                                                Value="False" />

                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>

                            </Button.Style>

                            <TextBlock
                                Text="Antworten"
                                FontWeight="SemiBold" />

                        </Button>

                        <Button
                            Width="140"
                            Height="36"
                            Margin="10,0,0,0"
                            Cursor="Hand"
                            ToolTip="Allen Empfängern antworten (Strg+Shift+R)"
                            Click="ReplyAllSelectedMessageButton_OnClick">

                            <Button.Style>

                                <Style TargetType="Button">

                                    <Setter
                                        Property="Background"
                                        Value="{StaticResource Surface.Background}" />

                                    <Setter
                                        Property="Foreground"
                                        Value="{StaticResource Text.Primary}" />

                                    <Setter
                                        Property="BorderBrush"
                                        Value="{StaticResource Border.Default}" />

                                    <Setter
                                        Property="BorderThickness"
                                        Value="1" />

                                    <Setter
                                        Property="IsEnabled"
                                        Value="True" />

                                    <Style.Triggers>

                                        <DataTrigger
                                            Binding="{Binding SelectedMessage}"
                                            Value="{x:Null}">

                                            <Setter
                                                Property="IsEnabled"
                                                Value="False" />

                                        </DataTrigger>

                                        <DataTrigger
                                            Binding="{Binding IsLoading}"
                                            Value="True">

                                            <Setter
                                                Property="IsEnabled"
                                                Value="False" />

                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>

                            </Button.Style>

                            <TextBlock
                                Text="Allen antworten"
                                FontWeight="SemiBold" />

                        </Button>

                        <Button
                            Width="125"
                            Height="36"
                            Margin="10,0,0,0"
                            Cursor="Hand"
                            ToolTip="Diese Nachricht weiterleiten (Strg+F)"
                            Click="ForwardSelectedMessageButton_OnClick">

                            <Button.Style>

                                <Style TargetType="Button">

                                    <Setter
                                        Property="Background"
                                        Value="{StaticResource Surface.Background}" />

                                    <Setter
                                        Property="Foreground"
                                        Value="{StaticResource Text.Primary}" />

                                    <Setter
                                        Property="BorderBrush"
                                        Value="{StaticResource Border.Default}" />

                                    <Setter
                                        Property="BorderThickness"
                                        Value="1" />

                                    <Setter
                                        Property="IsEnabled"
                                        Value="True" />

                                    <Style.Triggers>

                                        <DataTrigger
                                            Binding="{Binding SelectedMessage}"
                                            Value="{x:Null}">

                                            <Setter
                                                Property="IsEnabled"
                                                Value="False" />

                                        </DataTrigger>

                                        <DataTrigger
                                            Binding="{Binding IsLoading}"
                                            Value="True">

                                            <Setter
                                                Property="IsEnabled"
                                                Value="False" />

                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>

                            </Button.Style>

                            <TextBlock
                                Text="Weiterleiten"
                                FontWeight="SemiBold" />

                        </Button>

                    </StackPanel>

                </Grid>

                <Border
                    Grid.Row="1"
                    Background="{StaticResource Border.Subtle}" />

                <Border
                    x:Name="ExternalImagesNotice"
                    Grid.Row="2"
                    Margin="20,12,20,0"
                    Padding="14,10"
                    CornerRadius="6"
                    BorderBrush="{StaticResource Border.Default}"
                    BorderThickness="1"
                    Background="{StaticResource Brand.PrimaryLight}"
                    Visibility="Collapsed">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            Text="&#xE72E;"
                            Margin="0,0,10,0"
                            FontFamily="Segoe Fluent Icons"
                            FontSize="16"
                            Foreground="{StaticResource Brand.Primary}"
                            VerticalAlignment="Center" />

                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center">

                            <TextBlock
                                Text="Externe Bilder wurden blockiert."
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource Text.Primary}" />

                            <TextBlock
                                Text="Zum Schutz Ihrer Privatsphäre lädt Telenec Mail externe Bilder nicht automatisch."
                                Margin="0,2,12,0"
                                FontSize="11"
                                Foreground="{StaticResource Text.Secondary}"
                                TextWrapping="Wrap" />

                        </StackPanel>

                        <Button
                            Grid.Column="2"
                            Content="Trotzdem laden"
                            Margin="12,0,0,0"
                            Padding="12,6"
                            VerticalAlignment="Center"
                            Cursor="Hand"
                            Style="{StaticResource Button.Primary}"
                            Click="LoadExternalImagesButton_OnClick" />

                    </Grid>

                </Border>

                <!-- ANHÄNGE -->

                <Border
                    Grid.Row="3"
                    Margin="20,12,20,0"
                    Padding="14,12"
                    CornerRadius="6"
                    BorderBrush="{StaticResource Border.Default}"
                    BorderThickness="1"
                    Background="{StaticResource Surface.Background}">

                    <Border.Style>

                        <Style TargetType="Border">

                            <Setter
                                Property="Visibility"
                                Value="Collapsed" />

                            <Style.Triggers>

                                <DataTrigger
                                    Binding="{Binding SelectedMessage.HasAttachments}"
                                    Value="True">

                                    <Setter
                                        Property="Visibility"
                                        Value="Visible" />

                                </DataTrigger>

                            </Style.Triggers>

                        </Style>

                    </Border.Style>

                    <StackPanel>

                        <StackPanel
                            Orientation="Horizontal">

                            <TextBlock
                                Text="&#xE723;"
                                Margin="0,0,8,0"
                                FontFamily="Segoe Fluent Icons"
                                FontSize="16"
                                Foreground="{StaticResource Brand.Primary}"
                                VerticalAlignment="Center" />

                            <TextBlock
                                Text="{Binding SelectedMessage.AttachmentSummary}"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource Text.Primary}"
                                VerticalAlignment="Center" />

                        </StackPanel>

                        <ItemsControl
                            Margin="0,4,0,0"
                            ItemsSource="{Binding SelectedMessage.Attachments}">

                            <ItemsControl.ItemsPanel>

                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>

                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>

                                <DataTemplate>

                                    <Button
                                        Margin="0,6,8,0"
                                        MinWidth="180"
                                        MaxWidth="310"
                                        Padding="0"
                                        Cursor="Hand"
                                        ToolTip="Anhang speichern unter …"
                                        Click="SaveAttachmentButton_OnClick">

                                        <Button.Template>

                                            <ControlTemplate TargetType="Button">

                                                <Border
                                                    x:Name="AttachmentCard"
                                                    Padding="10,8"
                                                    CornerRadius="5"
                                                    BorderBrush="{StaticResource Border.Default}"
                                                    BorderThickness="1"
                                                    Background="{StaticResource Surface.Card}">

                                                    <ContentPresenter />

                                                </Border>

                                                <ControlTemplate.Triggers>

                                                    <Trigger
                                                        Property="IsMouseOver"
                                                        Value="True">

                                                        <Setter
                                                            TargetName="AttachmentCard"
                                                            Property="BorderBrush"
                                                            Value="{StaticResource Brand.Primary}" />

                                                    </Trigger>

                                                    <Trigger
                                                        Property="IsKeyboardFocused"
                                                        Value="True">

                                                        <Setter
                                                            TargetName="AttachmentCard"
                                                            Property="BorderBrush"
                                                            Value="{StaticResource Brand.Primary}" />

                                                    </Trigger>

                                                </ControlTemplate.Triggers>

                                            </ControlTemplate>

                                        </Button.Template>

                                        <Grid>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock
                                                Grid.Column="0"
                                                Text="&#xE8A5;"
                                                Margin="0,0,9,0"
                                                FontFamily="Segoe Fluent Icons"
                                                FontSize="18"
                                                Foreground="{StaticResource Text.Secondary}"
                                                VerticalAlignment="Center" />

                                            <StackPanel
                                                Grid.Column="1">

                                                <TextBlock
                                                    Text="{Binding FileName}"
                                                    FontSize="12"
                                                    FontWeight="SemiBold"
                                                    Foreground="{StaticResource Text.Primary}"
                                                    TextTrimming="CharacterEllipsis"
                                                    ToolTip="{Binding FileName}" />

                                                <StackPanel
                                                    Margin="0,3,0,0"
                                                    Orientation="Horizontal">

                                                    <TextBlock
                                                        Text="{Binding ContentType}"
                                                        FontSize="10"
                                                        Foreground="{StaticResource Text.Secondary}"
                                                        TextTrimming="CharacterEllipsis" />

                                                    <TextBlock
                                                        Text=" · "
                                                        FontSize="10"
                                                        Foreground="{StaticResource Text.Muted}" />

                                                    <TextBlock
                                                        Text="{Binding DisplaySize}"
                                                        FontSize="10"
                                                        Foreground="{StaticResource Text.Secondary}" />

                                                </StackPanel>

                                            </StackPanel>

                                            <TextBlock
                                                Grid.Column="2"
                                                Text="&#xE74E;"
                                                Margin="12,0,0,0"
                                                FontFamily="Segoe Fluent Icons"
                                                FontSize="15"
                                                Foreground="{StaticResource Brand.Primary}"
                                                VerticalAlignment="Center" />

                                        </Grid>

                                    </Button>

                                </DataTemplate>

                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </StackPanel>

                </Border>

                <!-- MAILINHALT -->

                <Grid Grid.Row="4">

                    <ScrollViewer
                        x:Name="PlainTextMailView"
                        VerticalScrollBarVisibility="Auto">

                        <StackPanel
                            Margin="44,36,44,36"
                            MaxWidth="760"
                            HorizontalAlignment="Left">

                            <TextBlock
                                Text="{Binding SelectedMessage.Greeting}"
                                FontSize="14"
                                Foreground="{StaticResource Text.Primary}" />

                            <TextBlock
                                Margin="0,20,0,0"
                                Text="{Binding SelectedMessage.Body}"
                                TextWrapping="Wrap"
                                FontSize="14"
                                LineHeight="22"
                                Foreground="{StaticResource Text.Primary}" />

                            <Border
                                Margin="0,28,0,28"
                                Padding="18"
                                CornerRadius="8"
                                Background="{StaticResource Brand.PrimaryLight}">

                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter
                                            Property="Visibility"
                                            Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger
                                                Binding="{Binding SelectedMessage.HasHighlight}"
                                                Value="True">
                                                <Setter
                                                    Property="Visibility"
                                                    Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <StackPanel>

                                    <TextBlock
                                        Text="{Binding SelectedMessage.HighlightTitle}"
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource Text.Primary}" />

                                    <TextBlock
                                        Margin="0,6,0,0"
                                        Text="{Binding SelectedMessage.HighlightText}"
                                        FontSize="12"
                                        Foreground="{StaticResource Text.Secondary}"
                                        TextWrapping="Wrap" />

                                </StackPanel>

                            </Border>

                            <TextBlock
                                Text="{Binding SelectedMessage.Closing}"
                                FontSize="14"
                                Foreground="{StaticResource Text.Primary}" />

                            <TextBlock
                                Margin="0,5,0,0"
                                Text="{Binding SelectedMessage.Signature}"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource Text.Primary}" />

                        </StackPanel>

                    </ScrollViewer>

                    <wv2:WebView2
                        x:Name="HtmlMailView"
                        Visibility="Collapsed" />

                </Grid>

            </Grid>

        </Border>

    </Grid>

</Window>