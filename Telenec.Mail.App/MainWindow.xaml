<Window x:Class="Telenec.Mail.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mail="clr-namespace:Telenec.Mail.App.Services.Mail"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="{Binding ApplicationTitle}"
        Width="1400"
        Height="820"
        MinWidth="1100"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Surface.Background}"
        Foreground="{StaticResource Text.Primary}"
        FontFamily="{StaticResource Typography.FontFamily}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- =====================================================
             LINKE NAVIGATION
             ===================================================== -->

        <Border
            Grid.Column="0"
            Background="{StaticResource Navigation.Background}">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel
                    Grid.Row="0"
                    Margin="22,22,22,18">

                    <Image
                        Source="/Assets/Brand/TelenecLogo.png"
                        Height="72"
                        HorizontalAlignment="Left"
                        Stretch="Uniform" />

                    <TextBlock
                        Text="MAIL"
                        Margin="4,5,0,0"
                        Foreground="{StaticResource Navigation.TextSecondary}"
                        FontSize="12"
                        FontWeight="SemiBold" />

                </StackPanel>

                <Border
                    Grid.Row="1"
                    Margin="16,0,16,18"
                    Padding="12,9"
                    CornerRadius="6"
                    Background="{StaticResource Navigation.Selected}">

                    <StackPanel Orientation="Horizontal">

                        <Ellipse
                            Width="8"
                            Height="8"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center">

                            <Ellipse.Style>

                                <Style TargetType="Ellipse">

                                    <Setter
                                        Property="Fill"
                                        Value="{StaticResource Status.Information}" />

                                    <Style.Triggers>

                                        <DataTrigger
                                            Binding="{Binding ConnectionState}"
                                            Value="{x:Static mail:MailConnectionState.Connected}">

                                            <Setter
                                                Property="Fill"
                                                Value="{StaticResource Status.Success}" />

                                        </DataTrigger>

                                        <DataTrigger
                                            Binding="{Binding ConnectionState}"
                                            Value="{x:Static mail:MailConnectionState.Offline}">

                                            <Setter
                                                Property="Fill"
                                                Value="{StaticResource Status.Warning}" />

                                        </DataTrigger>

                                        <DataTrigger
                                            Binding="{Binding ConnectionState}"
                                            Value="{x:Static mail:MailConnectionState.AuthenticationRequired}">

                                            <Setter
                                                Property="Fill"
                                                Value="{StaticResource Status.Warning}" />

                                        </DataTrigger>

                                        <DataTrigger
                                            Binding="{Binding ConnectionState}"
                                            Value="{x:Static mail:MailConnectionState.SecurityError}">

                                            <Setter
                                                Property="Fill"
                                                Value="{StaticResource Status.Error}" />

                                        </DataTrigger>

                                        <DataTrigger
                                            Binding="{Binding ConnectionState}"
                                            Value="{x:Static mail:MailConnectionState.Error}">

                                            <Setter
                                                Property="Fill"
                                                Value="{StaticResource Status.Error}" />

                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>

                            </Ellipse.Style>

                        </Ellipse>

                        <TextBlock
                            Text="{Binding ConnectionStatusText}"
                            Foreground="{StaticResource Navigation.TextSecondary}"
                            FontSize="12"
                            VerticalAlignment="Center" />

                    </StackPanel>

                </Border>

                <ListBox
                    Grid.Row="2"
                    ItemsSource="{Binding MailFolders}"
                    SelectedItem="{Binding SelectedFolder, Mode=TwoWay}"
                    Style="{StaticResource Navigation.FolderList}"
                    ItemContainerStyle="{StaticResource Navigation.FolderItem}">

                    <ListBox.ItemTemplate>

                        <DataTemplate>

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    x:Name="FolderNameText"
                                    Grid.Column="0"
                                    Text="{Binding DisplayName}"
                                    Style="{StaticResource Navigation.ItemText}" />

                                <Border
                                    x:Name="UnreadBadge"
                                    Grid.Column="1"
                                    MinWidth="26"
                                    Height="22"
                                    Padding="7,0"
                                    CornerRadius="11"
                                    Background="{StaticResource Brand.Primary}"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed">

                                    <TextBlock
                                        Text="{Binding UnreadCount}"
                                        Foreground="White"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />

                                </Border>

                            </Grid>

                            <DataTemplate.Triggers>

                                <DataTrigger
                                    Binding="{Binding HasUnreadCount}"
                                    Value="True">

                                    <Setter
                                        TargetName="UnreadBadge"
                                        Property="Visibility"
                                        Value="Visible" />

                                </DataTrigger>

                                <DataTrigger
                                    Binding="{Binding IsSelected,
                                        RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}"
                                    Value="True">

                                    <Setter
                                        TargetName="FolderNameText"
                                        Property="Margin"
                                        Value="16,0,0,0" />

                                    <Setter
                                        TargetName="FolderNameText"
                                        Property="FontWeight"
                                        Value="SemiBold" />

                                </DataTrigger>

                            </DataTemplate.Triggers>

                        </DataTemplate>

                    </ListBox.ItemTemplate>

                </ListBox>

                <Border
                    Grid.Row="3"
                    Padding="20,18"
                    BorderBrush="{StaticResource Navigation.Selected}"
                    BorderThickness="0,1,0,0">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>

                            <TextBlock
                                x:Name="AccountEmailText"
                                Text="Telenec-Konto"
                                Foreground="{StaticResource Navigation.Text}"
                                FontSize="12"
                                FontWeight="SemiBold"
                                TextTrimming="CharacterEllipsis" />

                            <TextBlock
                                Text="Telenec Mail"
                                Margin="0,3,0,0"
                                Foreground="{StaticResource Navigation.TextSecondary}"
                                FontSize="11" />

                        </StackPanel>

                        <Button
                            x:Name="AccountMenuButton"
                            Grid.Column="1"
                            Width="34"
                            Height="34"
                            Margin="10,0,0,0"
                            Padding="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            ToolTip="Kontoeinstellungen"
                            Click="AccountMenuButton_OnClick">

                            <Button.ContextMenu>

                                <ContextMenu>

                                    <MenuItem
                                        Header="Konto abmelden"
                                        Click="LogoutMenuItem_OnClick" />

                                </ContextMenu>

                            </Button.ContextMenu>

                            <TextBlock
                                Text="&#xE713;"
                                FontFamily="Segoe Fluent Icons"
                                Foreground="{StaticResource Navigation.TextSecondary}"
                                FontSize="18"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />

                        </Button>

                    </Grid>

                </Border>

            </Grid>

        </Border>

        <!-- =====================================================
             NACHRICHTENLISTE
             ===================================================== -->

        <Border
            Grid.Column="1"
            Background="{StaticResource Surface.Card}"
            BorderBrush="{StaticResource Border.Default}"
            BorderThickness="0,0,1,0">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid
                    Grid.Row="0"
                    Margin="22,22,22,14">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>

                        <TextBlock
                            Text="{Binding SelectedFolder.DisplayName}"
                            FontSize="24"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource Text.Primary}" />

                        <TextBlock
                            Text="{Binding SelectedFolder.HeaderSubtitle}"
                            Margin="0,4,0,0"
                            FontSize="12"
                            Foreground="{StaticResource Text.Secondary}" />

                    </StackPanel>

                    <Button
                        x:Name="RefreshButton"
                        Grid.Column="1"
                        Width="36"
                        Height="36"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        ToolTip="Postfach aktualisieren"
                        Click="RefreshButton_OnClick">

                        <TextBlock
                            Text="&#xE72C;"
                            FontFamily="Segoe Fluent Icons"
                            FontSize="18"
                            Foreground="{StaticResource Text.Secondary}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />

                    </Button>

                </Grid>

                <Border
                    Grid.Row="1"
                    Margin="18,0,18,14"
                    Height="38"
                    Background="{StaticResource Surface.Background}"
                    BorderBrush="{StaticResource Border.Default}"
                    BorderThickness="1"
                    CornerRadius="6">

                    <Grid Margin="12,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Text="&#xE721;"
                            FontFamily="Segoe Fluent Icons"
                            FontSize="15"
                            Foreground="{StaticResource Text.Secondary}"
                            VerticalAlignment="Center" />

                        <TextBlock
                            Grid.Column="1"
                            Margin="9,0,0,0"
                            Text="E-Mails durchsuchen"
                            FontSize="13"
                            Foreground="{StaticResource Text.Muted}"
                            VerticalAlignment="Center" />

                    </Grid>

                </Border>

                <ListBox
                    Grid.Row="2"
                    ItemsSource="{Binding Messages}"
                    SelectedItem="{Binding SelectedMessage, Mode=TwoWay}"
                    Style="{StaticResource MailList.MessageList}"
                    ItemContainerStyle="{StaticResource MailList.MessageItem}">

                    <ListBox.ItemTemplate>

                        <DataTemplate>

                            <StackPanel>

                                <StackPanel.ContextMenu>

                                    <ContextMenu
                                        DataContext="{Binding PlacementTarget.DataContext,
                                            RelativeSource={RelativeSource Self}}">

                                        <MenuItem
                                            Header="Als ungelesen markieren"
                                            IsEnabled="{Binding CanMarkAsUnread}"
                                            Click="MarkAsUnreadMenuItem_OnClick" />

                                        <Separator />

                                        <MenuItem
                                            Header="Löschen"
                                            Click="DeleteMenuItem_OnClick" />

                                    </ContextMenu>

                                </StackPanel.ContextMenu>

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel
                                        Grid.Column="0"
                                        Orientation="Horizontal">

                                        <Ellipse
                                            x:Name="UnreadIndicator"
                                            Width="7"
                                            Height="7"
                                            Margin="0,0,8,0"
                                            Fill="{StaticResource Brand.Primary}"
                                            VerticalAlignment="Center"
                                            Visibility="Collapsed" />

                                        <TextBlock
                                            x:Name="SenderText"
                                            Text="{Binding Sender}"
                                            FontSize="13"
                                            Foreground="{StaticResource Text.Primary}" />

                                    </StackPanel>

                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{Binding DisplayTime}"
                                        FontSize="11"
                                        Foreground="{StaticResource Text.Secondary}" />

                                </Grid>

                                <TextBlock
                                    x:Name="SubjectText"
                                    Margin="0,7,0,0"
                                    Text="{Binding Subject}"
                                    FontSize="14"
                                    Foreground="{StaticResource Text.Primary}" />

                                <TextBlock
                                    Margin="0,5,0,0"
                                    Text="{Binding Preview}"
                                    FontSize="12"
                                    Foreground="{StaticResource Text.Secondary}"
                                    TextTrimming="CharacterEllipsis" />

                            </StackPanel>

                            <DataTemplate.Triggers>

                                <DataTrigger
                                    Binding="{Binding IsUnread}"
                                    Value="True">

                                    <Setter
                                        TargetName="UnreadIndicator"
                                        Property="Visibility"
                                        Value="Visible" />

                                    <Setter
                                        TargetName="SenderText"
                                        Property="FontWeight"
                                        Value="SemiBold" />

                                    <Setter
                                        TargetName="SubjectText"
                                        Property="FontWeight"
                                        Value="SemiBold" />

                                </DataTrigger>

                                <DataTrigger
                                    Binding="{Binding EmphasizeSender}"
                                    Value="True">

                                    <Setter
                                        TargetName="SenderText"
                                        Property="FontWeight"
                                        Value="SemiBold" />

                                </DataTrigger>

                            </DataTemplate.Triggers>

                        </DataTemplate>

                    </ListBox.ItemTemplate>

                </ListBox>

                <Border
                    Grid.Row="2"
                    Background="{StaticResource Surface.Card}">

                    <Border.Style>

                        <Style TargetType="Border">

                            <Setter
                                Property="Visibility"
                                Value="Collapsed" />

                            <Style.Triggers>

                                <DataTrigger
                                    Binding="{Binding IsLoading}"
                                    Value="True">

                                    <Setter
                                        Property="Visibility"
                                        Value="Visible" />

                                </DataTrigger>

                            </Style.Triggers>

                        </Style>

                    </Border.Style>

                    <StackPanel
                        Width="260"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                        <TextBlock
                            Text="{Binding LoadingMessage}"
                            Margin="0,0,0,14"
                            FontSize="13"
                            Foreground="{StaticResource Text.Secondary}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />

                        <ProgressBar
                            Height="4"
                            IsIndeterminate="True" />

                    </StackPanel>

                </Border>

                <Border
                    Grid.Row="2"
                    Background="{StaticResource Surface.Card}">

                    <Border.Style>

                        <Style TargetType="Border">

                            <Setter
                                Property="Visibility"
                                Value="Collapsed" />

                            <Style.Triggers>

                                <DataTrigger
                                    Binding="{Binding HasLoadError}"
                                    Value="True">

                                    <Setter
                                        Property="Visibility"
                                        Value="Visible" />

                                </DataTrigger>

                            </Style.Triggers>

                        </Style>

                    </Border.Style>

                    <StackPanel
                        Width="285"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                        <TextBlock
                            Text="E-Mails konnten nicht geladen werden"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource Text.Primary}"
                            TextAlignment="Center" />

                        <TextBlock
                            Text="{Binding LoadErrorMessage}"
                            Margin="0,9,0,18"
                            FontSize="12"
                            Foreground="{StaticResource Text.Secondary}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />

                        <Button
                            Content="Erneut versuchen"
                            HorizontalAlignment="Center"
                            Style="{StaticResource Button.Primary}"
                            Click="RetryButton_OnClick" />

                    </StackPanel>

                </Border>

                <Border
                    Grid.Row="2"
                    Background="{StaticResource Surface.Card}">

                    <Border.Style>

                        <Style TargetType="Border">

                            <Setter
                                Property="Visibility"
                                Value="Collapsed" />

                            <Style.Triggers>

                                <DataTrigger
                                    Binding="{Binding IsEmptyFolder}"
                                    Value="True">

                                    <Setter
                                        Property="Visibility"
                                        Value="Visible" />

                                </DataTrigger>

                            </Style.Triggers>

                        </Style>

                    </Border.Style>

                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                        <TextBlock
                            Text="Dieser Ordner ist leer."
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource Text.Primary}"
                            HorizontalAlignment="Center" />

                        <TextBlock
                            Text="Hier befinden sich momentan keine Nachrichten."
                            Margin="0,6,0,0"
                            FontSize="12"
                            Foreground="{StaticResource Text.Secondary}"
                            HorizontalAlignment="Center" />

                    </StackPanel>

                </Border>

            </Grid>

        </Border>

        <!-- =====================================================
             LESEBEREICH
             ===================================================== -->

        <Border
            Grid.Column="2"
            Background="{StaticResource Surface.Card}">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="1" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid
                    Grid.Row="0"
                    Margin="32,26,32,22">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="0,0,12,0"
                        Text="{Binding SelectedMessage.Subject}"
                        FontSize="25"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource Text.Primary}"
                        TextWrapping="Wrap" />

                    <Button
                        x:Name="DeleteSelectedMessageButton"
                        Grid.Row="0"
                        Grid.Column="1"
                        Width="36"
                        Height="36"
                        Margin="12,0,0,0"
                        Padding="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Cursor="Hand"
                        ToolTip="Nachricht löschen"
                        Click="DeleteSelectedMessageButton_OnClick">

                        <Button.Style>

                            <Style TargetType="Button">

                                <Setter
                                    Property="Background"
                                    Value="Transparent" />

                                <Setter
                                    Property="BorderThickness"
                                    Value="0" />

                                <Setter
                                    Property="IsEnabled"
                                    Value="True" />

                                <Style.Triggers>

                                    <DataTrigger
                                        Binding="{Binding SelectedMessage}"
                                        Value="{x:Null}">

                                        <Setter
                                            Property="IsEnabled"
                                            Value="False" />

                                    </DataTrigger>

                                    <DataTrigger
                                        Binding="{Binding IsLoading}"
                                        Value="True">

                                        <Setter
                                            Property="IsEnabled"
                                            Value="False" />

                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>

                        </Button.Style>

                        <TextBlock
                            Text="&#xE74D;"
                            FontFamily="Segoe Fluent Icons"
                            FontSize="18"
                            Foreground="{StaticResource Text.Secondary}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />

                    </Button>

                    <Grid
                        Grid.Row="1"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Margin="0,20,0,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Width="40"
                            Height="40"
                            CornerRadius="20"
                            Background="{StaticResource Brand.Primary}">

                            <TextBlock
                                Text="{Binding SelectedMessage.SenderInitial}"
                                Foreground="White"
                                FontSize="17"
                                FontWeight="SemiBold"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />

                        </Border>

                        <StackPanel
                            Grid.Column="1"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center">

                            <TextBlock
                                Text="{Binding SelectedMessage.Sender}"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource Text.Primary}" />

                            <TextBlock
                                Margin="0,3,0,0"
                                Text="{Binding SelectedMessage.AddressLine}"
                                FontSize="11"
                                Foreground="{StaticResource Text.Secondary}"
                                TextTrimming="CharacterEllipsis" />

                        </StackPanel>

                        <TextBlock
                            Grid.Column="2"
                            Text="{Binding SelectedMessage.DisplayDateTime}"
                            FontSize="11"
                            Foreground="{StaticResource Text.Secondary}"
                            VerticalAlignment="Center"
                            Margin="18,0,0,0" />

                    </Grid>

                </Grid>

                <Border
                    Grid.Row="1"
                    Background="{StaticResource Border.Subtle}" />

                <!-- Externe Bilder -->

                <Border
                    x:Name="ExternalImagesNotice"
                    Grid.Row="2"
                    Margin="20,12,20,0"
                    Padding="14,10"
                    CornerRadius="6"
                    BorderBrush="{StaticResource Border.Default}"
                    BorderThickness="1"
                    Background="{StaticResource Brand.PrimaryLight}"
                    Visibility="Collapsed">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            Text="&#xE72E;"
                            Margin="0,0,10,0"
                            FontFamily="Segoe Fluent Icons"
                            FontSize="16"
                            Foreground="{StaticResource Brand.Primary}"
                            VerticalAlignment="Center" />

                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center">

                            <TextBlock
                                Text="Externe Bilder wurden blockiert."
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource Text.Primary}" />

                            <TextBlock
                                Text="Zum Schutz Ihrer Privatsphäre lädt Telenec Mail externe Bilder nicht automatisch."
                                Margin="0,2,12,0"
                                FontSize="11"
                                Foreground="{StaticResource Text.Secondary}"
                                TextWrapping="Wrap" />

                        </StackPanel>

                        <Button
                            Grid.Column="2"
                            Content="Trotzdem laden"
                            Margin="12,0,0,0"
                            Padding="12,6"
                            VerticalAlignment="Center"
                            Cursor="Hand"
                            Style="{StaticResource Button.Primary}"
                            Click="LoadExternalImagesButton_OnClick" />

                    </Grid>

                </Border>

                <Grid Grid.Row="3">

                    <!-- Plaintext / Fallback -->

                    <ScrollViewer
                        x:Name="PlainTextMailView"
                        VerticalScrollBarVisibility="Auto">

                        <StackPanel
                            Margin="44,36,44,36"
                            MaxWidth="760"
                            HorizontalAlignment="Left">

                            <TextBlock
                                Text="{Binding SelectedMessage.Greeting}"
                                FontSize="14"
                                Foreground="{StaticResource Text.Primary}" />

                            <TextBlock
                                Margin="0,20,0,0"
                                Text="{Binding SelectedMessage.Body}"
                                TextWrapping="Wrap"
                                FontSize="14"
                                LineHeight="22"
                                Foreground="{StaticResource Text.Primary}" />

                            <Border
                                Margin="0,28,0,28"
                                Padding="18"
                                CornerRadius="8"
                                Background="{StaticResource Brand.PrimaryLight}">

                                <Border.Style>

                                    <Style TargetType="Border">

                                        <Setter
                                            Property="Visibility"
                                            Value="Collapsed" />

                                        <Style.Triggers>

                                            <DataTrigger
                                                Binding="{Binding SelectedMessage.HasHighlight}"
                                                Value="True">

                                                <Setter
                                                    Property="Visibility"
                                                    Value="Visible" />

                                            </DataTrigger>

                                        </Style.Triggers>

                                    </Style>

                                </Border.Style>

                                <StackPanel>

                                    <TextBlock
                                        Text="{Binding SelectedMessage.HighlightTitle}"
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource Text.Primary}" />

                                    <TextBlock
                                        Margin="0,6,0,0"
                                        Text="{Binding SelectedMessage.HighlightText}"
                                        FontSize="12"
                                        Foreground="{StaticResource Text.Secondary}"
                                        TextWrapping="Wrap" />

                                </StackPanel>

                            </Border>

                            <TextBlock
                                Text="{Binding SelectedMessage.Closing}"
                                FontSize="14"
                                Foreground="{StaticResource Text.Primary}" />

                            <TextBlock
                                Margin="0,5,0,0"
                                Text="{Binding SelectedMessage.Signature}"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource Text.Primary}" />

                        </StackPanel>

                    </ScrollViewer>

                    <!-- HTML-Mail -->

                    <wv2:WebView2
                        x:Name="HtmlMailView"
                        Visibility="Collapsed" />

                </Grid>

            </Grid>

        </Border>

    </Grid>

</Window>