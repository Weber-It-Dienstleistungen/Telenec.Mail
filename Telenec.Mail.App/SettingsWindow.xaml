<Window x:Class="Telenec.Mail.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Telenec Mail – Einstellungen"
        Width="900"
        Height="620"
        MinWidth="760"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource Surface.Background}"
        Foreground="{StaticResource Text.Primary}"
        FontFamily="{StaticResource Typography.FontFamily}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Loaded="SettingsWindow_OnLoaded">

    <Window.Resources>

        <!--
            Die Navigation gehört bewusst nur zu diesem Fenster.

            Dadurch erweitern wir das globale Theme für den
            ersten Settings-Unterbau noch nicht unnötig.
        -->

        <Style
            x:Key="SettingsNavigationItemStyle"
            TargetType="ListBoxItem">

            <Setter
                Property="Margin"
                Value="0,2" />

            <Setter
                Property="Padding"
                Value="14,11" />

            <Setter
                Property="HorizontalContentAlignment"
                Value="Stretch" />

            <Setter
                Property="Foreground"
                Value="{StaticResource Navigation.TextSecondary}" />

            <Setter
                Property="Background"
                Value="Transparent" />

            <Setter
                Property="BorderThickness"
                Value="0" />

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate
                        TargetType="ListBoxItem">

                        <Border
                            x:Name="ItemBorder"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6">

                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center" />

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger
                                Property="IsMouseOver"
                                Value="True">

                                <Setter
                                    TargetName="ItemBorder"
                                    Property="Background"
                                    Value="{StaticResource Navigation.Hover}" />

                                <Setter
                                    Property="Foreground"
                                    Value="{StaticResource Navigation.Text}" />

                            </Trigger>

                            <Trigger
                                Property="IsSelected"
                                Value="True">

                                <Setter
                                    TargetName="ItemBorder"
                                    Property="Background"
                                    Value="{StaticResource Navigation.Selected}" />

                                <Setter
                                    Property="Foreground"
                                    Value="{StaticResource Navigation.Text}" />

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Window.Resources>

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- NAVIGATION -->

        <Border
            Grid.Column="0"
            Background="{StaticResource Navigation.Background}">

            <Grid Margin="18">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Image
                    Grid.Row="0"
                    Source="/Assets/Brand/TelenecMailLogo.png"
                    Width="170"
                    Margin="4,8,4,24"
                    HorizontalAlignment="Left"
                    Stretch="Uniform" />

                <TextBlock
                    Grid.Row="1"
                    Text="Einstellungen"
                    Margin="4,0,4,12"
                    Foreground="{StaticResource Navigation.Text}"
                    FontSize="16"
                    FontWeight="SemiBold" />

                <ListBox
                    x:Name="SettingsNavigation"
                    Grid.Row="2"
                    SelectedIndex="0"
                    Background="Transparent"
                    BorderThickness="0"
                    ItemContainerStyle="{StaticResource SettingsNavigationItemStyle}"
                    SelectionChanged="SettingsNavigation_OnSelectionChanged">

                    <ListBoxItem>

                        <StackPanel Orientation="Horizontal">

                            <TextBlock
                                Text="&#xE115;"
                                Width="24"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="15"
                                VerticalAlignment="Center" />

                            <TextBlock
                                Text="Allgemein"
                                FontSize="13"
                                FontWeight="SemiBold"
                                VerticalAlignment="Center" />

                        </StackPanel>

                    </ListBoxItem>

                    <ListBoxItem>

                        <StackPanel Orientation="Horizontal">

                            <TextBlock
                                Text="&#xE70F;"
                                Width="24"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="15"
                                VerticalAlignment="Center" />

                            <TextBlock
                                Text="Verfassen"
                                FontSize="13"
                                FontWeight="SemiBold"
                                VerticalAlignment="Center" />

                        </StackPanel>

                    </ListBoxItem>

                    <ListBoxItem>

                        <StackPanel Orientation="Horizontal">

                            <TextBlock
                                Text="&#xEA8F;"
                                Width="24"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="15"
                                VerticalAlignment="Center" />

                            <TextBlock
                                Text="Benachrichtigungen"
                                FontSize="13"
                                FontWeight="SemiBold"
                                VerticalAlignment="Center" />

                        </StackPanel>

                    </ListBoxItem>

                </ListBox>

            </Grid>

        </Border>

        <!-- INHALT -->

        <Grid
            Grid.Column="1"
            Margin="36,30,36,26">

            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ALLGEMEIN -->

            <Grid
                x:Name="GeneralSettingsPanel"
                Grid.Row="0">

                <StackPanel>

                    <TextBlock
                        Text="Allgemein"
                        FontSize="26"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource Text.Primary}" />

                    <TextBlock
                        Text="Allgemeine Einstellungen für Telenec Mail."
                        Margin="0,6,0,26"
                        FontSize="13"
                        Foreground="{StaticResource Text.Secondary}" />

                    <Border
                        Padding="22"
                        Background="{StaticResource Surface.Card}"
                        BorderBrush="{StaticResource Border.Default}"
                        BorderThickness="1"
                        CornerRadius="8">

                        <StackPanel>

                            <TextBlock
                                Text="Lokale Programmeinstellungen"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource Text.Primary}" />

                            <TextBlock
                                Margin="0,7,0,0"
                                Text="Einstellungen in diesem Bereich gelten für die gesamte Anwendung auf diesem Computer."
                                FontSize="13"
                                Foreground="{StaticResource Text.Secondary}"
                                TextWrapping="Wrap" />

                            <TextBlock
                                Margin="0,18,0,0"
                                Text="Noch keine Einstellungen verfügbar."
                                FontSize="13"
                                Foreground="{StaticResource Text.Secondary}" />

                        </StackPanel>

                    </Border>

                </StackPanel>

            </Grid>

            <!-- VERFASSEN -->

            <Grid
                x:Name="ComposeSettingsPanel"
                Grid.Row="0"
                Visibility="Collapsed">

                <StackPanel>

                    <TextBlock
                        Text="Verfassen"
                        FontSize="26"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource Text.Primary}" />

                    <TextBlock
                        Text="Einstellungen für das Schreiben und Versenden von E-Mails."
                        Margin="0,6,0,26"
                        FontSize="13"
                        Foreground="{StaticResource Text.Secondary}" />

                    <Border
                        Padding="22"
                        Background="{StaticResource Surface.Card}"
                        BorderBrush="{StaticResource Border.Default}"
                        BorderThickness="1"
                        CornerRadius="8">

                        <StackPanel>

                            <TextBlock
                                Text="Signatur"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource Text.Primary}" />

                            <TextBlock
                                x:Name="SignatureAccountText"
                                Margin="0,7,0,0"
                                Text="Aktuelles Konto wird geladen …"
                                FontSize="12"
                                Foreground="{StaticResource Text.Secondary}"
                                TextWrapping="Wrap" />

                            <StackPanel
                                x:Name="SignatureSettingsControls"
                                Margin="0,20,0,0"
                                IsEnabled="False">

                                <CheckBox
                                    x:Name="SignatureEnabledCheckBox"
                                    Content="Signatur verwenden"
                                    Foreground="{StaticResource Text.Primary}"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Checked="SignatureSetting_OnChanged"
                                    Unchecked="SignatureSetting_OnChanged" />

                                <TextBlock
                                    Margin="0,18,0,6"
                                    Text="Signaturtext"
                                    FontSize="12"
                                    Foreground="{StaticResource Text.Secondary}" />

                                <TextBox
                                    x:Name="SignatureTextBox"
                                    Height="160"
                                    Padding="10,8"
                                    AcceptsReturn="True"
                                    AcceptsTab="True"
                                    TextWrapping="Wrap"
                                    VerticalScrollBarVisibility="Auto"
                                    Background="{StaticResource Surface.Background}"
                                    Foreground="{StaticResource Text.Primary}"
                                    BorderBrush="{StaticResource Border.Default}"
                                    TextChanged="SignatureTextBox_OnTextChanged" />

                                <Grid Margin="0,16,0,0">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        x:Name="SignatureStatusText"
                                        Grid.Column="0"
                                        Margin="0,0,16,0"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{StaticResource Text.Secondary}"
                                        TextWrapping="Wrap" />

                                    <Button
                                        x:Name="SaveSignatureButton"
                                        Grid.Column="1"
                                        Width="120"
                                        Height="38"
                                        Content="Speichern"
                                        Cursor="Hand"
                                        Style="{StaticResource Button.Primary}"
                                        Click="SaveSignatureButton_OnClick" />

                                </Grid>

                            </StackPanel>

                        </StackPanel>

                    </Border>

                </StackPanel>

            </Grid>

            <!-- BENACHRICHTIGUNGEN -->

            <Grid
                x:Name="NotificationSettingsPanel"
                Grid.Row="0"
                Visibility="Collapsed">

                <StackPanel>

                    <TextBlock
                        Text="Benachrichtigungen"
                        FontSize="26"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource Text.Primary}" />

                    <TextBlock
                        Text="Einstellungen für Hinweise und Benachrichtigungen."
                        Margin="0,6,0,26"
                        FontSize="13"
                        Foreground="{StaticResource Text.Secondary}" />

                    <Border
                        Padding="22"
                        Background="{StaticResource Surface.Card}"
                        BorderBrush="{StaticResource Border.Default}"
                        BorderThickness="1"
                        CornerRadius="8">

                        <StackPanel>

                            <TextBlock
                                Text="Lokale Programmeinstellungen"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource Text.Primary}" />

                            <TextBlock
                                Margin="0,7,0,0"
                                Text="Benachrichtigungen werden später an dieser Stelle zentral verwaltet."
                                FontSize="13"
                                Foreground="{StaticResource Text.Secondary}"
                                TextWrapping="Wrap" />

                            <TextBlock
                                Margin="0,18,0,0"
                                Text="Noch keine Einstellungen verfügbar."
                                FontSize="13"
                                Foreground="{StaticResource Text.Secondary}" />

                        </StackPanel>

                    </Border>

                </StackPanel>

            </Grid>

            <!-- FUSS -->

            <Border
                Grid.Row="1"
                Margin="0,24,0,0"
                Padding="0,18,0,0"
                BorderBrush="{StaticResource Border.Default}"
                BorderThickness="0,1,0,0">

                <Button
                    Width="110"
                    Height="38"
                    HorizontalAlignment="Right"
                    Content="Schließen"
                    Cursor="Hand"
                    IsCancel="True"
                    Style="{StaticResource Button.Primary}"
                    Click="CloseButton_OnClick" />

            </Border>

        </Grid>

    </Grid>

</Window>