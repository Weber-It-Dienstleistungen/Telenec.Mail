<Window x:Class="Telenec.Mail.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Telenec.Mail.App.Controls"
        Title="Telenec Mail – Einstellungen"
        Width="1050"
        Height="780"
        MinWidth="900"
        MinHeight="680"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource Surface.Background}"
        Foreground="{StaticResource Text.Primary}"
        FontFamily="{StaticResource Typography.FontFamily}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Loaded="SettingsWindow_OnLoaded">

    <Window.Resources>

        <Style
            x:Key="SettingsNavigationItemStyle"
            TargetType="ListBoxItem">

            <Setter
                Property="Margin"
                Value="0,2" />

            <Setter
                Property="Padding"
                Value="14,11" />

            <Setter
                Property="HorizontalContentAlignment"
                Value="Stretch" />

            <Setter
                Property="Foreground"
                Value="{StaticResource Navigation.TextSecondary}" />

            <Setter
                Property="Background"
                Value="Transparent" />

            <Setter
                Property="BorderThickness"
                Value="0" />

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate
                        TargetType="ListBoxItem">

                        <Border
                            x:Name="ItemBorder"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6">

                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center" />

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger
                                Property="IsMouseOver"
                                Value="True">

                                <Setter
                                    TargetName="ItemBorder"
                                    Property="Background"
                                    Value="{StaticResource Navigation.Hover}" />

                                <Setter
                                    Property="Foreground"
                                    Value="{StaticResource Navigation.Text}" />

                            </Trigger>

                            <Trigger
                                Property="IsSelected"
                                Value="True">

                                <Setter
                                    TargetName="ItemBorder"
                                    Property="Background"
                                    Value="{StaticResource Navigation.Selected}" />

                                <Setter
                                    Property="Foreground"
                                    Value="{StaticResource Navigation.Text}" />

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Window.Resources>

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- NAVIGATION -->

        <Border
            Grid.Column="0"
            Background="{StaticResource Navigation.Background}">

            <Grid Margin="18">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Image
                    Grid.Row="0"
                    Source="/Assets/Brand/TelenecMailLogo.png"
                    Width="170"
                    Margin="4,8,4,24"
                    HorizontalAlignment="Left"
                    Stretch="Uniform" />

                <TextBlock
                    Grid.Row="1"
                    Text="Einstellungen"
                    Margin="4,0,4,12"
                    Foreground="{StaticResource Navigation.Text}"
                    FontSize="16"
                    FontWeight="SemiBold" />

                <ListBox
                    x:Name="SettingsNavigation"
                    Grid.Row="2"
                    SelectedIndex="0"
                    Background="Transparent"
                    BorderThickness="0"
                    ItemContainerStyle="{StaticResource SettingsNavigationItemStyle}"
                    SelectionChanged="SettingsNavigation_OnSelectionChanged">

                    <ListBoxItem>

                        <StackPanel Orientation="Horizontal">

                            <TextBlock
                                Text="&#xE115;"
                                Width="24"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="15"
                                VerticalAlignment="Center" />

                            <TextBlock
                                Text="Allgemein"
                                FontSize="13"
                                FontWeight="SemiBold"
                                VerticalAlignment="Center" />

                        </StackPanel>

                    </ListBoxItem>

                    <ListBoxItem>

                        <StackPanel Orientation="Horizontal">

                            <TextBlock
                                Text="&#xE70F;"
                                Width="24"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="15"
                                VerticalAlignment="Center" />

                            <TextBlock
                                Text="Verfassen"
                                FontSize="13"
                                FontWeight="SemiBold"
                                VerticalAlignment="Center" />

                        </StackPanel>

                    </ListBoxItem>

                    <ListBoxItem>

                        <StackPanel Orientation="Horizontal">

                            <TextBlock
                                Text="&#xEA8F;"
                                Width="24"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="15"
                                VerticalAlignment="Center" />

                            <TextBlock
                                Text="Benachrichtigungen"
                                FontSize="13"
                                FontWeight="SemiBold"
                                VerticalAlignment="Center" />

                        </StackPanel>

                    </ListBoxItem>

                </ListBox>

            </Grid>

        </Border>

        <!-- INHALT -->

        <Grid
            Grid.Column="1"
            Margin="36,30,36,26">

            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ALLGEMEIN -->

            <Grid
                x:Name="GeneralSettingsPanel"
                Grid.Row="0">

                <StackPanel>

                    <TextBlock
                        Text="Allgemein"
                        FontSize="26"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource Text.Primary}" />

                    <TextBlock
                        Text="Allgemeine Einstellungen für Telenec Mail."
                        Margin="0,6,0,26"
                        FontSize="13"
                        Foreground="{StaticResource Text.Secondary}" />

                    <Border
                        Padding="22"
                        Background="{StaticResource Surface.Card}"
                        BorderBrush="{StaticResource Border.Default}"
                        BorderThickness="1"
                        CornerRadius="8">

                        <StackPanel>

                            <TextBlock
                                Text="Lokale Programmeinstellungen"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource Text.Primary}" />

                            <TextBlock
                                Margin="0,7,0,0"
                                Text="Einstellungen in diesem Bereich gelten für die gesamte Anwendung auf diesem Computer."
                                FontSize="13"
                                Foreground="{StaticResource Text.Secondary}"
                                TextWrapping="Wrap" />

                            <TextBlock
                                Margin="0,18,0,0"
                                Text="Noch keine Einstellungen verfügbar."
                                FontSize="13"
                                Foreground="{StaticResource Text.Secondary}" />

                        </StackPanel>

                    </Border>

                </StackPanel>

            </Grid>

            <!-- VERFASSEN -->

            <Grid
                x:Name="ComposeSettingsPanel"
                Grid.Row="0"
                Visibility="Collapsed">

                <ScrollViewer
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">

                    <StackPanel Margin="0,0,12,0">

                        <TextBlock
                            Text="Verfassen"
                            FontSize="26"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource Text.Primary}" />

                        <TextBlock
                            Text="Einstellungen für das Schreiben und Versenden von E-Mails."
                            Margin="0,6,0,26"
                            FontSize="13"
                            Foreground="{StaticResource Text.Secondary}" />

                        <Border
                            Padding="22"
                            Background="{StaticResource Surface.Card}"
                            BorderBrush="{StaticResource Border.Default}"
                            BorderThickness="1"
                            CornerRadius="8">

                            <StackPanel>

                                <TextBlock
                                    Text="Signatur"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource Text.Primary}" />

                                <TextBlock
                                    x:Name="SignatureAccountText"
                                    Margin="0,7,0,0"
                                    Text="Aktuelles Konto wird geladen …"
                                    FontSize="12"
                                    Foreground="{StaticResource Text.Secondary}"
                                    TextWrapping="Wrap" />

                                <StackPanel
                                    x:Name="SignatureSettingsControls"
                                    Margin="0,20,0,0"
                                    IsEnabled="False">

                                    <CheckBox
                                        x:Name="SignatureEnabledCheckBox"
                                        Content="Signatur verwenden"
                                        Foreground="{StaticResource Text.Primary}"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Checked="SignatureSetting_OnChanged"
                                        Unchecked="SignatureSetting_OnChanged" />

                                    <TextBlock
                                        Margin="0,18,0,6"
                                        Text="Signatur"
                                        FontSize="12"
                                        Foreground="{StaticResource Text.Secondary}" />

                                    <Border
                                        x:Name="SignatureFormattingToolbar"
                                        Padding="8,6"
                                        Background="{StaticResource Surface.Background}"
                                        BorderBrush="{StaticResource Border.Subtle}"
                                        BorderThickness="1,1,1,0"
                                        CornerRadius="6,6,0,0">

                                        <WrapPanel>

                                            <Button
                                                Width="36"
                                                Height="32"
                                                Margin="0,0,6,0"
                                                Padding="5,2"
                                                Tag="bold"
                                                ToolTip="Fett"
                                                Cursor="Hand"
                                                Click="SignatureRichTextCommandButton_OnClick">

                                                <TextBlock
                                                    Text="B"
                                                    FontWeight="Bold" />

                                            </Button>

                                            <Button
                                                Width="36"
                                                Height="32"
                                                Margin="0,0,6,0"
                                                Padding="5,2"
                                                Tag="italic"
                                                ToolTip="Kursiv"
                                                Cursor="Hand"
                                                Click="SignatureRichTextCommandButton_OnClick">

                                                <TextBlock
                                                    Text="I"
                                                    FontStyle="Italic" />

                                            </Button>

                                            <Button
                                                Width="36"
                                                Height="32"
                                                Margin="0,0,6,0"
                                                Padding="5,2"
                                                Tag="underline"
                                                ToolTip="Unterstrichen"
                                                Cursor="Hand"
                                                Click="SignatureRichTextCommandButton_OnClick">

                                                <TextBlock
                                                    Text="U"
                                                    TextDecorations="Underline" />

                                            </Button>

                                            <Button
                                                Width="72"
                                                Height="32"
                                                Margin="0,0,6,0"
                                                Padding="5,2"
                                                Tag="insertUnorderedList"
                                                Content="• Liste"
                                                ToolTip="Aufzählung ein-/ausschalten"
                                                Cursor="Hand"
                                                Click="SignatureRichTextCommandButton_OnClick" />

                                            <ComboBox
                                                Width="135"
                                                Height="32"
                                                Margin="0,0,6,0"
                                                Padding="7,3"
                                                Tag="fontName"
                                                SelectedIndex="0"
                                                VerticalContentAlignment="Center"
                                                ToolTip="Schriftart"
                                                SelectionChanged="SignatureRichTextCommandComboBox_OnSelectionChanged">

                                                <ComboBoxItem Content="Schriftart" Tag="" />
                                                <ComboBoxItem Content="Segoe UI" Tag="Segoe UI" />
                                                <ComboBoxItem Content="Arial" Tag="Arial" />
                                                <ComboBoxItem Content="Calibri" Tag="Calibri" />
                                                <ComboBoxItem Content="Verdana" Tag="Verdana" />
                                                <ComboBoxItem Content="Georgia" Tag="Georgia" />
                                                <ComboBoxItem Content="Times New Roman" Tag="Times New Roman" />
                                                <ComboBoxItem Content="Courier New" Tag="Courier New" />

                                            </ComboBox>

                                            <ComboBox
                                                Width="105"
                                                Height="32"
                                                Margin="0,0,6,0"
                                                Padding="7,3"
                                                Tag="fontSize"
                                                SelectedIndex="0"
                                                VerticalContentAlignment="Center"
                                                ToolTip="Schriftgröße"
                                                SelectionChanged="SignatureRichTextCommandComboBox_OnSelectionChanged">

                                                <ComboBoxItem Content="Größe" Tag="" />
                                                <ComboBoxItem Content="Klein" Tag="2" />
                                                <ComboBoxItem Content="Normal" Tag="3" />
                                                <ComboBoxItem Content="Groß" Tag="4" />
                                                <ComboBoxItem Content="Sehr groß" Tag="5" />

                                            </ComboBox>

                                            <ComboBox
                                                Width="105"
                                                Height="32"
                                                Margin="0,0,6,0"
                                                Padding="7,3"
                                                Tag="foreColor"
                                                SelectedIndex="0"
                                                VerticalContentAlignment="Center"
                                                ToolTip="Textfarbe"
                                                SelectionChanged="SignatureRichTextCommandComboBox_OnSelectionChanged">

                                                <ComboBoxItem Content="Farbe" Tag="" />
                                                <ComboBoxItem Content="Schwarz" Tag="#1F2328" />
                                                <ComboBoxItem Content="Rot" Tag="#CF222E" />
                                                <ComboBoxItem Content="Blau" Tag="#0969DA" />
                                                <ComboBoxItem Content="Grün" Tag="#238636" />
                                                <ComboBoxItem Content="Orange" Tag="#B7791F" />
                                                <ComboBoxItem Content="Lila" Tag="#8250DF" />
                                                <ComboBoxItem Content="Grau" Tag="#66707A" />

                                            </ComboBox>

                                        </WrapPanel>

                                    </Border>

                                    <Border
                                        Height="220"
                                        Background="{StaticResource Surface.Background}"
                                        BorderBrush="{StaticResource Border.Default}"
                                        BorderThickness="1"
                                        CornerRadius="0,0,6,6">

                                        <Grid>

                                            <controls:ComposeHtmlEditor
                                                x:Name="SignatureHtmlEditor"
                                                ContentChanged="SignatureHtmlEditor_OnContentChanged" />

                                            <TextBox
                                                x:Name="SignatureFallbackTextBox"
                                                Visibility="Collapsed"
                                                Padding="10,8"
                                                AcceptsReturn="True"
                                                AcceptsTab="True"
                                                TextWrapping="Wrap"
                                                VerticalScrollBarVisibility="Auto"
                                                Background="{StaticResource Surface.Background}"
                                                Foreground="{StaticResource Text.Primary}"
                                                BorderThickness="0"
                                                TextChanged="SignatureFallbackTextBox_OnTextChanged" />

                                        </Grid>

                                    </Border>

                                    <Grid Margin="0,18,0,0">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock
                                            x:Name="SignatureStatusText"
                                            Grid.Column="0"
                                            Margin="0,0,16,0"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="{StaticResource Text.Secondary}"
                                            TextWrapping="Wrap" />

                                        <Button
                                            x:Name="SaveSignatureButton"
                                            Grid.Column="1"
                                            Width="120"
                                            Height="38"
                                            Content="Speichern"
                                            Cursor="Hand"
                                            Style="{StaticResource Button.Primary}"
                                            Click="SaveSignatureButton_OnClick" />

                                    </Grid>

                                </StackPanel>

                            </StackPanel>

                        </Border>

                    </StackPanel>

                </ScrollViewer>

            </Grid>

            <!-- BENACHRICHTIGUNGEN -->

            <Grid
                x:Name="NotificationSettingsPanel"
                Grid.Row="0"
                Visibility="Collapsed">

                <ScrollViewer
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">

                    <StackPanel Margin="0,0,12,0">

                        <TextBlock
                            Text="Benachrichtigungen"
                            FontSize="26"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource Text.Primary}" />

                        <TextBlock
                            Text="Hinweise bei neuen E-Mails und Verhalten im Hintergrund."
                            Margin="0,6,0,26"
                            FontSize="13"
                            Foreground="{StaticResource Text.Secondary}" />

                        <StackPanel
                            x:Name="NotificationSettingsControls"
                            IsEnabled="False">

                            <!-- DESKTOP-BENACHRICHTIGUNGEN -->

                            <Border
                                Padding="22"
                                Background="{StaticResource Surface.Card}"
                                BorderBrush="{StaticResource Border.Default}"
                                BorderThickness="1"
                                CornerRadius="8">

                                <StackPanel>

                                    <TextBlock
                                        Text="Desktop-Benachrichtigungen"
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource Text.Primary}" />

                                    <TextBlock
                                        x:Name="NotificationAccountText"
                                        Margin="0,7,0,0"
                                        Text="Aktuelles Konto wird geladen …"
                                        FontSize="12"
                                        Foreground="{StaticResource Text.Secondary}"
                                        TextWrapping="Wrap" />

                                    <CheckBox
                                        x:Name="DesktopNotificationsEnabledCheckBox"
                                        Margin="0,20,0,0"
                                        Content="Bei neuen E-Mails benachrichtigen"
                                        Foreground="{StaticResource Text.Primary}"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Checked="NotificationSetting_OnChanged"
                                        Unchecked="NotificationSetting_OnChanged" />

                                    <TextBlock
                                        Margin="24,6,0,0"
                                        Text="Zeigt einen Windows-Hinweis an, wenn eine neue Nachricht im Postfach eingeht."
                                        FontSize="12"
                                        Foreground="{StaticResource Text.Secondary}"
                                        TextWrapping="Wrap" />

                                </StackPanel>

                            </Border>

                            <!-- HINTERGRUNDBETRIEB -->

                            <Border
                                Margin="0,16,0,0"
                                Padding="22"
                                Background="{StaticResource Surface.Card}"
                                BorderBrush="{StaticResource Border.Default}"
                                BorderThickness="1"
                                CornerRadius="8">

                                <StackPanel>

                                    <TextBlock
                                        Text="Hintergrundbetrieb"
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource Text.Primary}" />

                                    <TextBlock
                                        Margin="0,7,0,0"
                                        Text="Diese Einstellungen gelten für Telenec Mail auf diesem Computer."
                                        FontSize="12"
                                        Foreground="{StaticResource Text.Secondary}"
                                        TextWrapping="Wrap" />

                                    <CheckBox
                                        x:Name="CloseToTrayEnabledCheckBox"
                                        Margin="0,20,0,0"
                                        Content="Beim Schließen im Infobereich weiterlaufen"
                                        Foreground="{StaticResource Text.Primary}"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Checked="NotificationSetting_OnChanged"
                                        Unchecked="NotificationSetting_OnChanged" />

                                    <TextBlock
                                        Margin="24,6,0,0"
                                        Text="Das Hauptfenster wird geschlossen, Telenec Mail bleibt jedoch im Windows-Infobereich aktiv."
                                        FontSize="12"
                                        Foreground="{StaticResource Text.Secondary}"
                                        TextWrapping="Wrap" />

                                    <CheckBox
                                        x:Name="StartWithWindowsEnabledCheckBox"
                                        Margin="0,22,0,0"
                                        Content="Mit Windows starten"
                                        Foreground="{StaticResource Text.Primary}"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Checked="NotificationSetting_OnChanged"
                                        Unchecked="NotificationSetting_OnChanged" />

                                    <TextBlock
                                        Margin="24,6,0,0"
                                        Text="Telenec Mail wird nach der Windows-Anmeldung automatisch gestartet."
                                        FontSize="12"
                                        Foreground="{StaticResource Text.Secondary}"
                                        TextWrapping="Wrap" />

                                </StackPanel>

                            </Border>

                            <!-- SPEICHERN -->

                            <Grid Margin="0,18,0,0">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    x:Name="NotificationStatusText"
                                    Grid.Column="0"
                                    Margin="0,0,16,0"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{StaticResource Text.Secondary}"
                                    TextWrapping="Wrap" />

                                <Button
                                    Grid.Column="1"
                                    Width="120"
                                    Height="38"
                                    Content="Speichern"
                                    Cursor="Hand"
                                    Style="{StaticResource Button.Primary}"
                                    Click="SaveNotificationSettingsButton_OnClick" />

                            </Grid>

                        </StackPanel>

                    </StackPanel>

                </ScrollViewer>

            </Grid>

            <!-- FUSS -->

            <Border
                Grid.Row="1"
                Margin="0,24,0,0"
                Padding="0,18,0,0"
                BorderBrush="{StaticResource Border.Default}"
                BorderThickness="0,1,0,0">

                <Button
                    Width="110"
                    Height="38"
                    HorizontalAlignment="Right"
                    Content="Schließen"
                    Cursor="Hand"
                    IsCancel="True"
                    Style="{StaticResource Button.Primary}"
                    Click="CloseButton_OnClick" />

            </Border>

        </Grid>

    </Grid>

</Window>