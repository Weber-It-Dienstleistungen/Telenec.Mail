<Window x:Class="Telenec.Mail.App.ContactsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Telenec Mail — Kontakte"
        Width="1100"
        Height="720"
        MinWidth="950"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource Surface.Background}"
        Foreground="{StaticResource Text.Primary}"
        FontFamily="{StaticResource Typography.FontFamily}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid Margin="28">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Margin="0,0,0,20">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>

                <TextBlock
                    Text="Kontakte"
                    FontSize="26"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource Text.Primary}" />

                <TextBlock
                    Text="{Binding ContactCountText}"
                    Margin="0,5,0,0"
                    FontSize="12"
                    Foreground="{StaticResource Text.Secondary}" />

            </StackPanel>

            <Button
                Grid.Column="1"
                Width="42"
                Height="38"
                Padding="0"
                Background="{StaticResource Surface.Card}"
                BorderBrush="{StaticResource Border.Default}"
                BorderThickness="1"
                Cursor="Hand"
                ToolTip="Kontakte aktualisieren"
                Click="RefreshButton_OnClick">

                <TextBlock
                    Text="&#xE72C;"
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="17"
                    Foreground="{StaticResource Text.Secondary}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />

            </Button>

        </Grid>

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- LISTE -->

            <Border
                Grid.Column="0"
                Padding="18"
                Background="{StaticResource Surface.Card}"
                BorderBrush="{StaticResource Border.Default}"
                BorderThickness="1"
                CornerRadius="8">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border
                        Grid.Row="0"
                        Height="40"
                        Margin="0,0,0,14"
                        Background="{StaticResource Surface.Background}"
                        BorderBrush="{StaticResource Border.Default}"
                        BorderThickness="1"
                        CornerRadius="6">

                        <Grid Margin="12,0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Text="&#xE721;"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="15"
                                Foreground="{StaticResource Text.Secondary}"
                                VerticalAlignment="Center" />

                            <TextBox
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                Padding="0"
                                Text="{Binding SearchText,
                                    UpdateSourceTrigger=PropertyChanged}"
                                Background="Transparent"
                                BorderThickness="0"
                                FontSize="13"
                                Foreground="{StaticResource Text.Primary}"
                                VerticalContentAlignment="Center"
                                ToolTip="Kontakte durchsuchen" />

                        </Grid>

                    </Border>

                    <ListBox
                        Grid.Row="1"
                        ItemsSource="{Binding VisibleContacts}"
                        SelectedItem="{Binding SelectedContact, Mode=TwoWay}"
                        Background="Transparent"
                        BorderThickness="0"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                        <ListBox.ItemContainerStyle>

                            <Style TargetType="ListBoxItem">

                                <Setter
                                    Property="HorizontalContentAlignment"
                                    Value="Stretch" />

                                <Setter
                                    Property="Padding"
                                    Value="0" />

                                <Setter
                                    Property="Margin"
                                    Value="0,0,0,4" />

                            </Style>

                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>

                            <DataTemplate>

                                <Border
                                    Padding="12,10"
                                    CornerRadius="6">

                                    <StackPanel>

                                        <TextBlock
                                            Text="{Binding DisplayName}"
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource Text.Primary}"
                                            TextTrimming="CharacterEllipsis" />

                                        <TextBlock
                                            Text="{Binding EmailAddress}"
                                            Margin="0,3,0,0"
                                            FontSize="11"
                                            Foreground="{StaticResource Text.Secondary}"
                                            TextTrimming="CharacterEllipsis" />

                                    </StackPanel>

                                </Border>

                            </DataTemplate>

                        </ListBox.ItemTemplate>

                    </ListBox>

                </Grid>

            </Border>

            <!-- RECHTE SEITE -->

            <Grid Grid.Column="2">

                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- KONTAKT BEARBEITEN -->

                <Border
                    Grid.Row="0"
                    Padding="22"
                    Background="{StaticResource Surface.Card}"
                    BorderBrush="{StaticResource Border.Default}"
                    BorderThickness="1"
                    CornerRadius="8">

                    <ScrollViewer
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">

                        <StackPanel>

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel>

                                    <TextBlock
                                        Text="Kontakt"
                                        FontSize="18"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource Text.Primary}" />

                                    <TextBlock
                                        Text="{Binding SelectedContact.DisplayName}"
                                        Margin="0,4,0,0"
                                        FontSize="12"
                                        Foreground="{StaticResource Text.Secondary}" />

                                </StackPanel>

                                <Button
                                    Grid.Column="1"
                                    Height="36"
                                    Padding="14,0"
                                    Content="E-Mail schreiben"
                                    IsEnabled="{Binding CanComposeToSelectedContact}"
                                    Cursor="Hand"
                                    Click="ComposeMailButton_OnClick" />

                            </Grid>

                            <Grid Margin="0,18,0,0">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">

                                    <TextBlock
                                        Text="Vorname"
                                        Margin="0,0,0,5"
                                        FontSize="12"
                                        Foreground="{StaticResource Text.Secondary}" />

                                    <TextBox
                                        Height="36"
                                        Padding="9,5"
                                        Text="{Binding EditFirstName,
                                            UpdateSourceTrigger=PropertyChanged}" />

                                </StackPanel>

                                <StackPanel Grid.Column="2">

                                    <TextBlock
                                        Text="Nachname"
                                        Margin="0,0,0,5"
                                        FontSize="12"
                                        Foreground="{StaticResource Text.Secondary}" />

                                    <TextBox
                                        Height="36"
                                        Padding="9,5"
                                        Text="{Binding EditLastName,
                                            UpdateSourceTrigger=PropertyChanged}" />

                                </StackPanel>

                            </Grid>

                            <TextBlock
                                Text="Anzeigename"
                                Margin="0,14,0,5"
                                FontSize="12"
                                Foreground="{StaticResource Text.Secondary}" />

                            <TextBox
                                Height="36"
                                Padding="9,5"
                                Text="{Binding EditDisplayName,
                                    UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock
                                Text="E-Mail-Adresse"
                                Margin="0,14,0,5"
                                FontSize="12"
                                Foreground="{StaticResource Text.Secondary}" />

                            <TextBox
                                Height="36"
                                Padding="9,5"
                                Text="{Binding EditEmailAddress,
                                    UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock
                                Text="Telefon"
                                Margin="0,14,0,5"
                                FontSize="12"
                                Foreground="{StaticResource Text.Secondary}" />

                            <TextBox
                                Height="36"
                                Padding="9,5"
                                Text="{Binding EditPhoneNumber,
                                    UpdateSourceTrigger=PropertyChanged}" />

                            <Grid Margin="0,18,0,0">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Button
                                    Grid.Column="0"
                                    Height="38"
                                    Padding="14,0"
                                    Content="Kontakt löschen"
                                    IsEnabled="{Binding CanDeleteSelectedContact}"
                                    Cursor="Hand"
                                    Click="DeleteContactButton_OnClick" />

                                <Button
                                    Grid.Column="2"
                                    Height="38"
                                    Content="Änderungen speichern"
                                    IsEnabled="{Binding CanSaveSelectedContact}"
                                    Style="{StaticResource Button.Primary}"
                                    Click="SaveContactButton_OnClick" />

                            </Grid>

                        </StackPanel>

                    </ScrollViewer>

                </Border>

                <!-- NEUER KONTAKT -->

                <Border
                    Grid.Row="2"
                    Padding="22"
                    Background="{StaticResource Surface.Card}"
                    BorderBrush="{StaticResource Border.Default}"
                    BorderThickness="1"
                    CornerRadius="8">

                    <ScrollViewer
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">

                        <StackPanel>

                            <TextBlock
                                Text="Neuer Kontakt"
                                FontSize="18"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource Text.Primary}" />

                            <Grid Margin="0,16,0,0">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">

                                    <TextBlock
                                        Text="Vorname"
                                        Margin="0,0,0,5"
                                        FontSize="12"
                                        Foreground="{StaticResource Text.Secondary}" />

                                    <TextBox
                                        Height="36"
                                        Padding="9,5"
                                        Text="{Binding NewFirstName,
                                            UpdateSourceTrigger=PropertyChanged}" />

                                </StackPanel>

                                <StackPanel Grid.Column="2">

                                    <TextBlock
                                        Text="Nachname"
                                        Margin="0,0,0,5"
                                        FontSize="12"
                                        Foreground="{StaticResource Text.Secondary}" />

                                    <TextBox
                                        Height="36"
                                        Padding="9,5"
                                        Text="{Binding NewLastName,
                                            UpdateSourceTrigger=PropertyChanged}" />

                                </StackPanel>

                            </Grid>

                            <TextBlock
                                Text="Anzeigename"
                                Margin="0,14,0,5"
                                FontSize="12"
                                Foreground="{StaticResource Text.Secondary}" />

                            <TextBox
                                Height="36"
                                Padding="9,5"
                                Text="{Binding NewDisplayName,
                                    UpdateSourceTrigger=PropertyChanged}" />

                            <Grid Margin="0,14,0,0">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">

                                    <TextBlock
                                        Text="E-Mail-Adresse"
                                        Margin="0,0,0,5"
                                        FontSize="12"
                                        Foreground="{StaticResource Text.Secondary}" />

                                    <TextBox
                                        Height="36"
                                        Padding="9,5"
                                        Text="{Binding NewEmailAddress,
                                            UpdateSourceTrigger=PropertyChanged}" />

                                </StackPanel>

                                <StackPanel Grid.Column="2">

                                    <TextBlock
                                        Text="Telefon"
                                        Margin="0,0,0,5"
                                        FontSize="12"
                                        Foreground="{StaticResource Text.Secondary}" />

                                    <TextBox
                                        Height="36"
                                        Padding="9,5"
                                        Text="{Binding NewPhoneNumber,
                                            UpdateSourceTrigger=PropertyChanged}" />

                                </StackPanel>

                            </Grid>

                            <Button
                                Height="38"
                                Margin="0,18,0,0"
                                HorizontalAlignment="Right"
                                Content="Kontakt speichern"
                                IsEnabled="{Binding CanCreateContact}"
                                Style="{StaticResource Button.Primary}"
                                Click="CreateContactButton_OnClick" />

                        </StackPanel>

                    </ScrollViewer>

                </Border>

            </Grid>

        </Grid>

        <Grid
            Grid.Row="2"
            Margin="0,18,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Text="{Binding StatusText}"
                FontSize="12"
                Foreground="{StaticResource Text.Secondary}"
                VerticalAlignment="Center" />

            <Button
                Grid.Column="1"
                Width="110"
                Height="38"
                Content="Schließen"
                Cursor="Hand"
                Click="CloseButton_OnClick" />

        </Grid>

    </Grid>

</Window>