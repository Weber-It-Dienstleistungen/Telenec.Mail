<Window x:Class="Telenec.Mail.App.ContactsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Telenec Mail — Kontakte"
        Width="1050"
        Height="700"
        MinWidth="900"
        MinHeight="580"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource Surface.Background}"
        Foreground="{StaticResource Text.Primary}"
        FontFamily="{StaticResource Typography.FontFamily}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid Margin="28">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- KOPF -->

        <Grid Grid.Row="0"
              Margin="0,0,0,20">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>

                <TextBlock
                    Text="Kontakte"
                    FontSize="26"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource Text.Primary}" />

                <TextBlock
                    Margin="0,5,0,0"
                    Text="{Binding ContactCountText}"
                    FontSize="12"
                    Foreground="{StaticResource Text.Secondary}" />

            </StackPanel>

            <Button
                Grid.Column="1"
                Height="38"
                Padding="16,0"
                Content="+ Neuer Kontakt"
                Cursor="Hand"
                Style="{StaticResource Button.Primary}"
                Click="NewContactButton_OnClick" />

            <Button
                Grid.Column="3"
                Width="42"
                Height="38"
                Padding="0"
                Background="{StaticResource Surface.Card}"
                BorderBrush="{StaticResource Border.Default}"
                BorderThickness="1"
                Cursor="Hand"
                ToolTip="Kontakte aktualisieren"
                Click="RefreshButton_OnClick">

                <TextBlock
                    Text="&#xE72C;"
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="17"
                    Foreground="{StaticResource Text.Secondary}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />

            </Button>

        </Grid>

        <!-- INHALT -->

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- KONTAKTLISTE -->

            <Border
                Grid.Column="0"
                Padding="18"
                Background="{StaticResource Surface.Card}"
                BorderBrush="{StaticResource Border.Default}"
                BorderThickness="1"
                CornerRadius="8">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border
                        Grid.Row="0"
                        Height="40"
                        Margin="0,0,0,14"
                        Background="{StaticResource Surface.Background}"
                        BorderBrush="{StaticResource Border.Default}"
                        BorderThickness="1"
                        CornerRadius="6">

                        <Grid Margin="12,0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Text="&#xE721;"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="15"
                                Foreground="{StaticResource Text.Secondary}"
                                VerticalAlignment="Center" />

                            <TextBox
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                Padding="0"
                                Text="{Binding SearchText,
                                    UpdateSourceTrigger=PropertyChanged}"
                                Background="Transparent"
                                BorderThickness="0"
                                FontSize="13"
                                Foreground="{StaticResource Text.Primary}"
                                VerticalContentAlignment="Center"
                                ToolTip="Kontakte durchsuchen" />

                        </Grid>

                    </Border>

                    <ListBox
                        Grid.Row="1"
                        ItemsSource="{Binding VisibleContacts}"
                        SelectedItem="{Binding SelectedContact, Mode=TwoWay}"
                        Background="Transparent"
                        BorderThickness="0"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                        <ListBox.ItemContainerStyle>

                            <Style TargetType="ListBoxItem">

                                <Setter
                                    Property="HorizontalContentAlignment"
                                    Value="Stretch" />

                                <Setter
                                    Property="Padding"
                                    Value="0" />

                                <Setter
                                    Property="Margin"
                                    Value="0,0,0,4" />

                            </Style>

                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>

                            <DataTemplate>

                                <Border
                                    Padding="12,10"
                                    CornerRadius="6">

                                    <StackPanel>

                                        <TextBlock
                                            Text="{Binding DisplayName}"
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource Text.Primary}"
                                            TextTrimming="CharacterEllipsis" />

                                        <TextBlock
                                            Margin="0,3,0,0"
                                            Text="{Binding EmailAddress}"
                                            FontSize="11"
                                            Foreground="{StaticResource Text.Secondary}"
                                            TextTrimming="CharacterEllipsis" />

                                    </StackPanel>

                                </Border>

                            </DataTemplate>

                        </ListBox.ItemTemplate>

                    </ListBox>

                </Grid>

            </Border>

            <!-- DETAILANSICHT -->

            <Border
                Grid.Column="2"
                Padding="24"
                Background="{StaticResource Surface.Card}"
                BorderBrush="{StaticResource Border.Default}"
                BorderThickness="1"
                CornerRadius="8">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- HEADER -->

                    <Grid Grid.Row="0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Width="64"
                            Height="64"
                            CornerRadius="32"
                            Background="{StaticResource Surface.Background}"
                            BorderBrush="{StaticResource Border.Default}"
                            BorderThickness="1">

                            <TextBlock
                                Text="&#xE77B;"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="28"
                                Foreground="{StaticResource Text.Secondary}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />

                        </Border>

                        <StackPanel
                            Grid.Column="2"
                            VerticalAlignment="Center">

                            <TextBlock
                                Text="{Binding SelectedContact.DisplayName}"
                                FontSize="22"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource Text.Primary}"
                                TextTrimming="CharacterEllipsis" />

                            <TextBlock
                                Margin="0,5,0,0"
                                Text="{Binding SelectedContact.EmailAddress}"
                                FontSize="12"
                                Foreground="{StaticResource Text.Secondary}"
                                TextTrimming="CharacterEllipsis" />

                        </StackPanel>

                        <Button
                            Grid.Column="3"
                            Height="36"
                            Padding="14,0"
                            Content="E-Mail schreiben"
                            IsEnabled="{Binding CanComposeToSelectedContact}"
                            Cursor="Hand"
                            Click="ComposeMailButton_OnClick" />

                        <Button
                            Grid.Column="5"
                            Height="36"
                            Padding="14,0"
                            Content="Bearbeiten"
                            IsEnabled="{Binding HasSelectedContact}"
                            Cursor="Hand"
                            Style="{StaticResource Button.Primary}"
                            Click="EditContactButton_OnClick" />

                    </Grid>

                    <!-- DETAILS -->

                    <ScrollViewer
                        Grid.Row="1"
                        Margin="0,24,0,0"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">

                        <StackPanel>

                            <!-- KONTAKT -->

                            <TextBlock
                                Text="Kontakt"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource Text.Primary}" />

                            <Grid Margin="0,12,0,0">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock
                                    Grid.Row="0"
                                    Text="Vorname"
                                    Foreground="{StaticResource Text.Secondary}" />

                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Text="{Binding SelectedContact.FirstName}"
                                    Foreground="{StaticResource Text.Primary}" />

                                <TextBlock
                                    Grid.Row="1"
                                    Margin="0,8,0,0"
                                    Text="Nachname"
                                    Foreground="{StaticResource Text.Secondary}" />

                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Margin="0,8,0,0"
                                    Text="{Binding SelectedContact.LastName}"
                                    Foreground="{StaticResource Text.Primary}" />

                                <TextBlock
                                    Grid.Row="2"
                                    Margin="0,8,0,0"
                                    Text="E-Mail"
                                    Foreground="{StaticResource Text.Secondary}" />

                                <TextBlock
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Margin="0,8,0,0"
                                    Text="{Binding SelectedContact.EmailAddress}"
                                    Foreground="{StaticResource Text.Primary}" />

                                <TextBlock
                                    Grid.Row="3"
                                    Margin="0,8,0,0"
                                    Text="Telefon"
                                    Foreground="{StaticResource Text.Secondary}" />

                                <TextBlock
                                    Grid.Row="3"
                                    Grid.Column="1"
                                    Margin="0,8,0,0"
                                    Text="{Binding SelectedContact.PhoneNumber}"
                                    Foreground="{StaticResource Text.Primary}" />

                            </Grid>

                            <!-- BERUF -->

                            <Border
                                Height="1"
                                Margin="0,22,0,20"
                                Background="{StaticResource Border.Default}" />

                            <TextBlock
                                Text="Beruf"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource Text.Primary}" />

                            <Grid Margin="0,12,0,0">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock
                                    Grid.Row="0"
                                    Text="Firma"
                                    Foreground="{StaticResource Text.Secondary}" />

                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Text="{Binding SelectedContact.Company}"
                                    Foreground="{StaticResource Text.Primary}" />

                                <TextBlock
                                    Grid.Row="1"
                                    Margin="0,8,0,0"
                                    Text="Abteilung"
                                    Foreground="{StaticResource Text.Secondary}" />

                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Margin="0,8,0,0"
                                    Text="{Binding SelectedContact.Department}"
                                    Foreground="{StaticResource Text.Primary}" />

                                <TextBlock
                                    Grid.Row="2"
                                    Margin="0,8,0,0"
                                    Text="Position"
                                    Foreground="{StaticResource Text.Secondary}" />

                                <TextBlock
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Margin="0,8,0,0"
                                    Text="{Binding SelectedContact.JobTitle}"
                                    Foreground="{StaticResource Text.Primary}" />

                            </Grid>

                            <!-- PRIVATE ADRESSE -->

                            <Border
                                Height="1"
                                Margin="0,22,0,20"
                                Background="{StaticResource Border.Default}" />

                            <TextBlock
                                Text="Private Adresse"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource Text.Primary}" />

                            <Grid Margin="0,12,0,0">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock
                                    Grid.Row="0"
                                    Text="Straße"
                                    Foreground="{StaticResource Text.Secondary}" />

                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Text="{Binding SelectedContact.HomeAddress.Street}"
                                    Foreground="{StaticResource Text.Primary}" />

                                <TextBlock
                                    Grid.Row="1"
                                    Margin="0,8,0,0"
                                    Text="Postleitzahl"
                                    Foreground="{StaticResource Text.Secondary}" />

                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Margin="0,8,0,0"
                                    Text="{Binding SelectedContact.HomeAddress.PostalCode}"
                                    Foreground="{StaticResource Text.Primary}" />

                                <TextBlock
                                    Grid.Row="2"
                                    Margin="0,8,0,0"
                                    Text="Ort"
                                    Foreground="{StaticResource Text.Secondary}" />

                                <TextBlock
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Margin="0,8,0,0"
                                    Text="{Binding SelectedContact.HomeAddress.City}"
                                    Foreground="{StaticResource Text.Primary}" />

                                <TextBlock
                                    Grid.Row="3"
                                    Margin="0,8,0,0"
                                    Text="Land"
                                    Foreground="{StaticResource Text.Secondary}" />

                                <TextBlock
                                    Grid.Row="3"
                                    Grid.Column="1"
                                    Margin="0,8,0,0"
                                    Text="{Binding SelectedContact.HomeAddress.Country}"
                                    Foreground="{StaticResource Text.Primary}" />

                            </Grid>

                            <!-- WEITERE ANGABEN -->

                            <Border
                                Height="1"
                                Margin="0,22,0,20"
                                Background="{StaticResource Border.Default}" />

                            <TextBlock
                                Text="Weitere Angaben"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource Text.Primary}" />

                            <Grid Margin="0,12,0,0">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock
                                    Grid.Row="0"
                                    Text="Website"
                                    Foreground="{StaticResource Text.Secondary}" />

                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Text="{Binding SelectedContact.Website}"
                                    Foreground="{StaticResource Text.Primary}" />

                                <TextBlock
                                    Grid.Row="1"
                                    Margin="0,8,0,0"
                                    Text="Geburtstag"
                                    Foreground="{StaticResource Text.Secondary}" />

                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Margin="0,8,0,0"
                                    Text="{Binding SelectedContact.Birthday}"
                                    Foreground="{StaticResource Text.Primary}" />

                                <TextBlock
                                    Grid.Row="2"
                                    Margin="0,8,0,0"
                                    Text="Notizen"
                                    Foreground="{StaticResource Text.Secondary}" />

                                <TextBlock
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Margin="0,8,0,0"
                                    Text="{Binding SelectedContact.Notes}"
                                    TextWrapping="Wrap"
                                    Foreground="{StaticResource Text.Primary}" />

                            </Grid>

                        </StackPanel>

                    </ScrollViewer>

                    <!-- LÖSCHEN -->

                    <Button
                        Grid.Row="2"
                        Margin="0,18,0,0"
                        HorizontalAlignment="Left"
                        Height="36"
                        Padding="14,0"
                        Content="Kontakt löschen"
                        IsEnabled="{Binding CanDeleteSelectedContact}"
                        Cursor="Hand"
                        Click="DeleteContactButton_OnClick" />

                </Grid>

            </Border>

        </Grid>

        <!-- FUSS -->

        <Grid
            Grid.Row="2"
            Margin="0,18,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Text="{Binding StatusText}"
                FontSize="12"
                Foreground="{StaticResource Text.Secondary}"
                VerticalAlignment="Center" />

            <Button
                Grid.Column="1"
                Width="110"
                Height="38"
                Content="Schließen"
                Cursor="Hand"
                Click="CloseButton_OnClick" />

        </Grid>

    </Grid>

</Window>