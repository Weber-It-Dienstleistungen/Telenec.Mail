<Window x:Class="Telenec.Mail.App.ContactsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Telenec.Mail.App.Converters"
        Title="Telenec Mail — Kontakte"
        Width="1050"
        Height="700"
        MinWidth="900"
        MinHeight="580"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource Surface.Background}"
        Foreground="{StaticResource Text.Primary}"
        FontFamily="{StaticResource Typography.FontFamily}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>

        <converters:ContactPhotoImageConverter
            x:Key="ContactPhotoImageConverter" />

        <Style x:Key="DetailSectionHeader"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="14" />

            <Setter Property="FontWeight"
                    Value="SemiBold" />

            <Setter Property="Foreground"
                    Value="{StaticResource Text.Primary}" />

        </Style>

        <Style x:Key="DetailLabel"
               TargetType="TextBlock">

            <Setter Property="Width"
                    Value="155" />

            <Setter Property="Foreground"
                    Value="{StaticResource Text.Secondary}" />

            <Setter Property="VerticalAlignment"
                    Value="Top" />

        </Style>

        <Style x:Key="DetailValue"
               TargetType="TextBlock">

            <Setter Property="Foreground"
                    Value="{StaticResource Text.Primary}" />

            <Setter Property="TextWrapping"
                    Value="Wrap" />

            <Setter Property="VerticalAlignment"
                    Value="Top" />

        </Style>

    </Window.Resources>

    <Grid Margin="28">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- KOPF -->

        <Grid Grid.Row="0"
              Margin="0,0,0,20">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>

                <TextBlock
                    Text="Kontakte"
                    FontSize="26"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource Text.Primary}" />

                <TextBlock
                    Margin="0,5,0,0"
                    Text="{Binding ContactCountText}"
                    FontSize="12"
                    Foreground="{StaticResource Text.Secondary}" />

            </StackPanel>

            <Button
                Grid.Column="1"
                Height="38"
                Padding="16,0"
                Content="+ Neuer Kontakt"
                Cursor="Hand"
                Style="{StaticResource Button.Primary}"
                Click="NewContactButton_OnClick" />

            <Button
                Grid.Column="3"
                Width="42"
                Height="38"
                Padding="0"
                Background="{StaticResource Surface.Card}"
                BorderBrush="{StaticResource Border.Default}"
                BorderThickness="1"
                Cursor="Hand"
                ToolTip="Kontakte aktualisieren"
                Click="RefreshButton_OnClick">

                <TextBlock
                    Text="&#xE72C;"
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="17"
                    Foreground="{StaticResource Text.Secondary}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />

            </Button>

        </Grid>

        <!-- INHALT -->

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- KONTAKTLISTE -->

            <Border
                Grid.Column="0"
                Padding="18"
                Background="{StaticResource Surface.Card}"
                BorderBrush="{StaticResource Border.Default}"
                BorderThickness="1"
                CornerRadius="8">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border
                        Grid.Row="0"
                        Height="40"
                        Margin="0,0,0,14"
                        Background="{StaticResource Surface.Background}"
                        BorderBrush="{StaticResource Border.Default}"
                        BorderThickness="1"
                        CornerRadius="6">

                        <Grid Margin="12,0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Text="&#xE721;"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="15"
                                Foreground="{StaticResource Text.Secondary}"
                                VerticalAlignment="Center" />

                            <TextBox
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                Padding="0"
                                Text="{Binding SearchText,
                                    UpdateSourceTrigger=PropertyChanged}"
                                Background="Transparent"
                                BorderThickness="0"
                                FontSize="13"
                                Foreground="{StaticResource Text.Primary}"
                                VerticalContentAlignment="Center"
                                ToolTip="Kontakte durchsuchen" />

                        </Grid>

                    </Border>

                    <ListBox
                        Grid.Row="1"
                        ItemsSource="{Binding VisibleContacts}"
                        SelectedItem="{Binding SelectedContact, Mode=TwoWay}"
                        Background="Transparent"
                        BorderThickness="0"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                        <ListBox.ItemContainerStyle>

                            <Style TargetType="ListBoxItem">

                                <Setter
                                    Property="HorizontalContentAlignment"
                                    Value="Stretch" />

                                <Setter
                                    Property="Padding"
                                    Value="0" />

                                <Setter
                                    Property="Margin"
                                    Value="0,0,0,4" />

                            </Style>

                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>

                            <DataTemplate>

                                <Border
                                    Padding="12,10"
                                    CornerRadius="6">

                                    <StackPanel>

                                        <TextBlock
                                            Text="{Binding DisplayName}"
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource Text.Primary}"
                                            TextTrimming="CharacterEllipsis" />

                                        <TextBlock
                                            Margin="0,3,0,0"
                                            Text="{Binding EmailAddress}"
                                            FontSize="11"
                                            Foreground="{StaticResource Text.Secondary}"
                                            TextTrimming="CharacterEllipsis" />

                                    </StackPanel>

                                </Border>

                            </DataTemplate>

                        </ListBox.ItemTemplate>

                    </ListBox>

                </Grid>

            </Border>

            <!-- DETAILANSICHT -->

            <Border
                Grid.Column="2"
                Padding="24"
                Background="{StaticResource Surface.Card}"
                BorderBrush="{StaticResource Border.Default}"
                BorderThickness="1"
                CornerRadius="8">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- HEADER -->

                    <Grid Grid.Row="0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- KONTAKTFOTO -->

                        <Grid
                            Grid.Column="0"
                            Width="64"
                            Height="64">

                            <Ellipse
                                Fill="{StaticResource Surface.Background}"
                                Stroke="{StaticResource Border.Default}"
                                StrokeThickness="1" />

                            <!--
                                Das Symbol liegt hinter dem Foto.

                                Liefert der Converter kein Bild,
                                bleibt der ImageBrush transparent
                                und das Standardsymbol ist sichtbar.
                            -->

                            <TextBlock
                                Text="&#xE77B;"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="28"
                                Foreground="{StaticResource Text.Secondary}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />

                            <Ellipse
                                Stroke="{StaticResource Border.Default}"
                                StrokeThickness="1">

                                <Ellipse.Fill>

                                    <ImageBrush
                                        ImageSource="{Binding SelectedContact.PhotoData,
                                            Converter={StaticResource ContactPhotoImageConverter}}"
                                        Stretch="UniformToFill" />

                                </Ellipse.Fill>

                            </Ellipse>

                        </Grid>

                        <StackPanel
                            Grid.Column="2"
                            VerticalAlignment="Center">

                            <TextBlock
                                Text="{Binding SelectedContact.DisplayName}"
                                FontSize="22"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource Text.Primary}"
                                TextTrimming="CharacterEllipsis" />

                            <TextBlock
                                Margin="0,5,0,0"
                                Text="{Binding SelectedContact.EmailAddress}"
                                FontSize="12"
                                Foreground="{StaticResource Text.Secondary}"
                                TextTrimming="CharacterEllipsis" />

                        </StackPanel>

                        <Button
                            Grid.Column="3"
                            Height="36"
                            Padding="14,0"
                            Content="E-Mail schreiben"
                            IsEnabled="{Binding CanComposeToSelectedContact}"
                            Cursor="Hand"
                            Click="ComposeMailButton_OnClick" />

                        <Button
                            Grid.Column="5"
                            Height="36"
                            Padding="14,0"
                            Content="Bearbeiten"
                            IsEnabled="{Binding HasSelectedContact}"
                            Cursor="Hand"
                            Style="{StaticResource Button.Primary}"
                            Click="EditContactButton_OnClick" />

                    </Grid>

                    <!-- DATENBLATT -->

                    <ScrollViewer
                        Grid.Row="1"
                        Margin="0,24,0,0"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">

                        <StackPanel>

                            <!-- NAME -->

                            <TextBlock
                                Text="Name"
                                Style="{StaticResource DetailSectionHeader}" />

                            <StackPanel Margin="0,12,0,0">

                                <DockPanel Margin="0,0,0,7">

                                    <TextBlock
                                        Text="Anrede"
                                        Style="{StaticResource DetailLabel}" />

                                    <TextBlock
                                        Text="{Binding SelectedContact.Salutation}"
                                        Style="{StaticResource DetailValue}" />

                                </DockPanel>

                                <DockPanel Margin="0,0,0,7">

                                    <TextBlock
                                        Text="Titel"
                                        Style="{StaticResource DetailLabel}" />

                                    <TextBlock
                                        Text="{Binding SelectedContact.AcademicTitle}"
                                        Style="{StaticResource DetailValue}" />

                                </DockPanel>

                                <DockPanel Margin="0,0,0,7">

                                    <TextBlock
                                        Text="Vorname"
                                        Style="{StaticResource DetailLabel}" />

                                    <TextBlock
                                        Text="{Binding SelectedContact.FirstName}"
                                        Style="{StaticResource DetailValue}" />

                                </DockPanel>

                                <DockPanel Margin="0,0,0,7">

                                    <TextBlock
                                        Text="Zweiter Vorname"
                                        Style="{StaticResource DetailLabel}" />

                                    <TextBlock
                                        Text="{Binding SelectedContact.MiddleName}"
                                        Style="{StaticResource DetailValue}" />

                                </DockPanel>

                                <DockPanel Margin="0,0,0,7">

                                    <TextBlock
                                        Text="Nachname"
                                        Style="{StaticResource DetailLabel}" />

                                    <TextBlock
                                        Text="{Binding SelectedContact.LastName}"
                                        Style="{StaticResource DetailValue}" />

                                </DockPanel>

                                <DockPanel Margin="0,0,0,7">

                                    <TextBlock
                                        Text="Namenszusatz"
                                        Style="{StaticResource DetailLabel}" />

                                    <TextBlock
                                        Text="{Binding SelectedContact.NameSuffix}"
                                        Style="{StaticResource DetailValue}" />

                                </DockPanel>

                                <DockPanel>

                                    <TextBlock
                                        Text="Spitzname"
                                        Style="{StaticResource DetailLabel}" />

                                    <TextBlock
                                        Text="{Binding SelectedContact.Nickname}"
                                        Style="{StaticResource DetailValue}" />

                                </DockPanel>

                            </StackPanel>

                            <!-- E-MAIL -->

                            <Border
                                Height="1"
                                Margin="0,22,0,20"
                                Background="{StaticResource Border.Default}" />

                            <TextBlock
                                Text="E-Mail"
                                Style="{StaticResource DetailSectionHeader}" />

                            <StackPanel Margin="0,12,0,0">

                                <DockPanel Margin="0,0,0,7">

                                    <TextBlock
                                        Text="Bevorzugt"
                                        Style="{StaticResource DetailLabel}" />

                                    <TextBlock
                                        Text="{Binding SelectedContact.EmailAddress}"
                                        Style="{StaticResource DetailValue}" />

                                </DockPanel>

                                <DockPanel Margin="0,0,0,7">

                                    <TextBlock
                                        Text="Geschäftlich"
                                        Style="{StaticResource DetailLabel}" />

                                    <TextBlock
                                        Text="{Binding SelectedContact.BusinessEmailAddress}"
                                        Style="{StaticResource DetailValue}" />

                                </DockPanel>

                                <DockPanel Margin="0,0,0,7">

                                    <TextBlock
                                        Text="Privat"
                                        Style="{StaticResource DetailLabel}" />

                                    <TextBlock
                                        Text="{Binding SelectedContact.PrivateEmailAddress}"
                                        Style="{StaticResource DetailValue}" />

                                </DockPanel>

                                <DockPanel>

                                    <TextBlock
                                        Text="Weitere"
                                        Style="{StaticResource DetailLabel}" />

                                    <ItemsControl
                                        ItemsSource="{Binding SelectedContact.AdditionalEmailAddresses}">

                                        <ItemsControl.ItemTemplate>

                                            <DataTemplate>

                                                <TextBlock
                                                    Text="{Binding}"
                                                    Margin="0,0,0,4"
                                                    Style="{StaticResource DetailValue}" />

                                            </DataTemplate>

                                        </ItemsControl.ItemTemplate>

                                    </ItemsControl>

                                </DockPanel>

                            </StackPanel>

                            <!-- TELEFON -->

                            <Border
                                Height="1"
                                Margin="0,22,0,20"
                                Background="{StaticResource Border.Default}" />

                            <TextBlock
                                Text="Telefon"
                                Style="{StaticResource DetailSectionHeader}" />

                            <StackPanel Margin="0,12,0,0">

                                <DockPanel Margin="0,0,0,7">

                                    <TextBlock
                                        Text="Bevorzugt"
                                        Style="{StaticResource DetailLabel}" />

                                    <TextBlock
                                        Text="{Binding SelectedContact.PhoneNumber}"
                                        Style="{StaticResource DetailValue}" />

                                </DockPanel>

                                <DockPanel Margin="0,0,0,7">

                                    <TextBlock
                                        Text="Mobil"
                                        Style="{StaticResource DetailLabel}" />

                                    <TextBlock
                                        Text="{Binding SelectedContact.MobilePhoneNumber}"
                                        Style="{StaticResource DetailValue}" />

                                </DockPanel>

                                <DockPanel Margin="0,0,0,7">

                                    <TextBlock
                                        Text="Geschäftlich"
                                        Style="{StaticResource DetailLabel}" />

                                    <TextBlock
                                        Text="{Binding SelectedContact.BusinessPhoneNumber}"
                                        Style="{StaticResource DetailValue}" />

                                </DockPanel>

                                <DockPanel Margin="0,0,0,7">

                                    <TextBlock
                                        Text="Privat"
                                        Style="{StaticResource DetailLabel}" />

                                    <TextBlock
                                        Text="{Binding SelectedContact.PrivatePhoneNumber}"
                                        Style="{StaticResource DetailValue}" />

                                </DockPanel>

                                <DockPanel Margin="0,0,0,7">

                                    <TextBlock
                                        Text="Fax"
                                        Style="{StaticResource DetailLabel}" />

                                    <TextBlock
                                        Text="{Binding SelectedContact.FaxNumber}"
                                        Style="{StaticResource DetailValue}" />

                                </DockPanel>

                                <DockPanel>

                                    <TextBlock
                                        Text="Weitere"
                                        Style="{StaticResource DetailLabel}" />

                                    <ItemsControl
                                        ItemsSource="{Binding SelectedContact.AdditionalPhoneNumbers}">

                                        <ItemsControl.ItemTemplate>

                                            <DataTemplate>

                                                <TextBlock
                                                    Text="{Binding}"
                                                    Margin="0,0,0,4"
                                                    Style="{StaticResource DetailValue}" />

                                            </DataTemplate>

                                        </ItemsControl.ItemTemplate>

                                    </ItemsControl>

                                </DockPanel>

                            </StackPanel>

                            <!-- FIRMA -->

                            <Border
                                Height="1"
                                Margin="0,22,0,20"
                                Background="{StaticResource Border.Default}" />

                            <TextBlock
                                Text="Firma und Beruf"
                                Style="{StaticResource DetailSectionHeader}" />

                            <StackPanel Margin="0,12,0,0">

                                <DockPanel Margin="0,0,0,7">

                                    <TextBlock
                                        Text="Firma"
                                        Style="{StaticResource DetailLabel}" />

                                    <TextBlock
                                        Text="{Binding SelectedContact.Company}"
                                        Style="{StaticResource DetailValue}" />

                                </DockPanel>

                                <DockPanel Margin="0,0,0,7">

                                    <TextBlock
                                        Text="Abteilung"
                                        Style="{StaticResource DetailLabel}" />

                                    <TextBlock
                                        Text="{Binding SelectedContact.Department}"
                                        Style="{StaticResource DetailValue}" />

                                </DockPanel>

                                <DockPanel>

                                    <TextBlock
                                        Text="Position"
                                        Style="{StaticResource DetailLabel}" />

                                    <TextBlock
                                        Text="{Binding SelectedContact.JobTitle}"
                                        Style="{StaticResource DetailValue}" />

                                </DockPanel>

                            </StackPanel>

                            <!-- PRIVATE ADRESSE -->

                            <Border
                                Height="1"
                                Margin="0,22,0,20"
                                Background="{StaticResource Border.Default}" />

                            <TextBlock
                                Text="Private Adresse"
                                Style="{StaticResource DetailSectionHeader}" />

                            <StackPanel Margin="0,12,0,0">

                                <DockPanel Margin="0,0,0,7">

                                    <TextBlock
                                        Text="Postfach"
                                        Style="{StaticResource DetailLabel}" />

                                    <TextBlock
                                        Text="{Binding SelectedContact.HomeAddress.PostOfficeBox}"
                                        Style="{StaticResource DetailValue}" />

                                </DockPanel>

                                <DockPanel Margin="0,0,0,7">

                                    <TextBlock
                                        Text="Adresszusatz"
                                        Style="{StaticResource DetailLabel}" />

                                    <TextBlock
                                        Text="{Binding SelectedContact.HomeAddress.ExtendedAddress}"
                                        Style="{StaticResource DetailValue}" />

                                </DockPanel>

                                <DockPanel Margin="0,0,0,7">

                                    <TextBlock
                                        Text="Straße"
                                        Style="{StaticResource DetailLabel}" />

                                    <TextBlock
                                        Text="{Binding SelectedContact.HomeAddress.Street}"
                                        Style="{StaticResource DetailValue}" />

                                </DockPanel>

                                <DockPanel Margin="0,0,0,7">

                                    <TextBlock
                                        Text="PLZ"
                                        Style="{StaticResource DetailLabel}" />

                                    <TextBlock
                                        Text="{Binding SelectedContact.HomeAddress.PostalCode}"
                                        Style="{StaticResource DetailValue}" />

                                </DockPanel>

                                <DockPanel Margin="0,0,0,7">

                                    <TextBlock
                                        Text="Ort"
                                        Style="{StaticResource DetailLabel}" />

                                    <TextBlock
                                        Text="{Binding SelectedContact.HomeAddress.City}"
                                        Style="{StaticResource DetailValue}" />

                                </DockPanel>

                                <DockPanel Margin="0,0,0,7">

                                    <TextBlock
                                        Text="Bundesland / Region"
                                        Style="{StaticResource DetailLabel}" />

                                    <TextBlock
                                        Text="{Binding SelectedContact.HomeAddress.Region}"
                                        Style="{StaticResource DetailValue}" />

                                </DockPanel>

                                <DockPanel>

                                    <TextBlock
                                        Text="Land"
                                        Style="{StaticResource DetailLabel}" />

                                    <TextBlock
                                        Text="{Binding SelectedContact.HomeAddress.Country}"
                                        Style="{StaticResource DetailValue}" />

                                </DockPanel>

                            </StackPanel>

                            <!-- GESCHÄFTLICHE ADRESSE -->

                            <Border
                                Height="1"
                                Margin="0,22,0,20"
                                Background="{StaticResource Border.Default}" />

                            <TextBlock
                                Text="Geschäftliche Adresse"
                                Style="{StaticResource DetailSectionHeader}" />

                            <StackPanel Margin="0,12,0,0">

                                <DockPanel Margin="0,0,0,7">

                                    <TextBlock
                                        Text="Postfach"
                                        Style="{StaticResource DetailLabel}" />

                                    <TextBlock
                                        Text="{Binding SelectedContact.WorkAddress.PostOfficeBox}"
                                        Style="{StaticResource DetailValue}" />

                                </DockPanel>

                                <DockPanel Margin="0,0,0,7">

                                    <TextBlock
                                        Text="Adresszusatz"
                                        Style="{StaticResource DetailLabel}" />

                                    <TextBlock
                                        Text="{Binding SelectedContact.WorkAddress.ExtendedAddress}"
                                        Style="{StaticResource DetailValue}" />

                                </DockPanel>

                                <DockPanel Margin="0,0,0,7">

                                    <TextBlock
                                        Text="Straße"
                                        Style="{StaticResource DetailLabel}" />

                                    <TextBlock
                                        Text="{Binding SelectedContact.WorkAddress.Street}"
                                        Style="{StaticResource DetailValue}" />

                                </DockPanel>

                                <DockPanel Margin="0,0,0,7">

                                    <TextBlock
                                        Text="PLZ"
                                        Style="{StaticResource DetailLabel}" />

                                    <TextBlock
                                        Text="{Binding SelectedContact.WorkAddress.PostalCode}"
                                        Style="{StaticResource DetailValue}" />

                                </DockPanel>

                                <DockPanel Margin="0,0,0,7">

                                    <TextBlock
                                        Text="Ort"
                                        Style="{StaticResource DetailLabel}" />

                                    <TextBlock
                                        Text="{Binding SelectedContact.WorkAddress.City}"
                                        Style="{StaticResource DetailValue}" />

                                </DockPanel>

                                <DockPanel Margin="0,0,0,7">

                                    <TextBlock
                                        Text="Bundesland / Region"
                                        Style="{StaticResource DetailLabel}" />

                                    <TextBlock
                                        Text="{Binding SelectedContact.WorkAddress.Region}"
                                        Style="{StaticResource DetailValue}" />

                                </DockPanel>

                                <DockPanel>

                                    <TextBlock
                                        Text="Land"
                                        Style="{StaticResource DetailLabel}" />

                                    <TextBlock
                                        Text="{Binding SelectedContact.WorkAddress.Country}"
                                        Style="{StaticResource DetailValue}" />

                                </DockPanel>

                            </StackPanel>

                            <!-- WEITERE ANGABEN -->

                            <Border
                                Height="1"
                                Margin="0,22,0,20"
                                Background="{StaticResource Border.Default}" />

                            <TextBlock
                                Text="Weitere Angaben"
                                Style="{StaticResource DetailSectionHeader}" />

                            <StackPanel Margin="0,12,0,0">

                                <DockPanel Margin="0,0,0,7">

                                    <TextBlock
                                        Text="Website"
                                        Style="{StaticResource DetailLabel}" />

                                    <TextBlock
                                        Text="{Binding SelectedContact.Website}"
                                        Style="{StaticResource DetailValue}" />

                                </DockPanel>

                                <DockPanel Margin="0,0,0,7">

                                    <TextBlock
                                        Text="Geburtstag"
                                        Style="{StaticResource DetailLabel}" />

                                    <TextBlock
                                        Text="{Binding SelectedContact.Birthday}"
                                        Style="{StaticResource DetailValue}" />

                                </DockPanel>

                                <DockPanel Margin="0,0,0,7">

                                    <TextBlock
                                        Text="Gruppen"
                                        Style="{StaticResource DetailLabel}" />

                                    <ItemsControl
                                        ItemsSource="{Binding SelectedContact.Categories}">

                                        <ItemsControl.ItemsPanel>

                                            <ItemsPanelTemplate>

                                                <WrapPanel />

                                            </ItemsPanelTemplate>

                                        </ItemsControl.ItemsPanel>

                                        <ItemsControl.ItemTemplate>

                                            <DataTemplate>

                                                <Border
                                                    Margin="0,0,6,4"
                                                    Padding="8,3"
                                                    CornerRadius="4"
                                                    Background="{StaticResource Surface.Background}"
                                                    BorderBrush="{StaticResource Border.Default}"
                                                    BorderThickness="1">

                                                    <TextBlock
                                                        Text="{Binding}"
                                                        FontSize="11"
                                                        Foreground="{StaticResource Text.Primary}" />

                                                </Border>

                                            </DataTemplate>

                                        </ItemsControl.ItemTemplate>

                                    </ItemsControl>

                                </DockPanel>

                                <DockPanel>

                                    <TextBlock
                                        Text="Notizen"
                                        Style="{StaticResource DetailLabel}" />

                                    <TextBlock
                                        Text="{Binding SelectedContact.Notes}"
                                        Style="{StaticResource DetailValue}" />

                                </DockPanel>

                            </StackPanel>

                        </StackPanel>

                    </ScrollViewer>

                    <!-- LÖSCHEN -->

                    <Button
                        Grid.Row="2"
                        Margin="0,18,0,0"
                        HorizontalAlignment="Left"
                        Height="36"
                        Padding="14,0"
                        Content="Kontakt löschen"
                        IsEnabled="{Binding CanDeleteSelectedContact}"
                        Cursor="Hand"
                        Click="DeleteContactButton_OnClick" />

                </Grid>

            </Border>

        </Grid>

        <!-- FUSS -->

        <Grid
            Grid.Row="2"
            Margin="0,18,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Text="{Binding StatusText}"
                FontSize="12"
                Foreground="{StaticResource Text.Secondary}"
                VerticalAlignment="Center" />

            <Button
                Grid.Column="1"
                Width="110"
                Height="38"
                Content="Schließen"
                Cursor="Hand"
                Click="CloseButton_OnClick" />

        </Grid>

    </Grid>

</Window>