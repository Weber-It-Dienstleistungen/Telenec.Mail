<Window x:Class="Telenec.Mail.App.WhatsNewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Telenec Mail – Was ist neu?"
        Width="580"
        SizeToContent="Height"
        MaxHeight="650"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource Surface.Background}"
        Foreground="{StaticResource Text.Primary}"
        FontFamily="{StaticResource Typography.FontFamily}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid Margin="32">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- FESTER KOPFBEREICH -->

        <StackPanel Grid.Row="0">

            <Image
                Source="/Assets/Brand/TelenecMailLogo.png"
                Width="260"
                Margin="0,0,0,24"
                HorizontalAlignment="Left"
                Stretch="Uniform" />

            <TextBlock
                Text="{Binding Title}"
                FontSize="24"
                FontWeight="SemiBold"
                Foreground="{StaticResource Text.Primary}" />

            <TextBlock
                Text="{Binding Version, StringFormat=Version {0}}"
                Margin="0,5,0,0"
                FontSize="11"
                Foreground="{StaticResource Text.Secondary}" />

        </StackPanel>

        <!-- NUR DIE RELEASE NOTES SCROLLEN -->

        <ScrollViewer
            Grid.Row="1"
            Margin="0,18,0,0"
            MaxHeight="330"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled">

            <StackPanel>

                <TextBlock
                    Text="{Binding Intro}"
                    FontSize="14"
                    Foreground="{StaticResource Text.Secondary}"
                    TextWrapping="Wrap" />

                <Border
                    Margin="0,20,0,0"
                    Padding="20"
                    Background="{StaticResource Surface.Card}"
                    BorderBrush="{StaticResource Border.Default}"
                    BorderThickness="1"
                    CornerRadius="8">

                    <ItemsControl
                        ItemsSource="{Binding Changes}">

                        <ItemsControl.ItemTemplate>

                            <DataTemplate>

                                <Grid Margin="0,7">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Grid.Column="0"
                                        Text="•"
                                        Margin="0,0,10,0"
                                        FontSize="16"
                                        FontWeight="Bold"
                                        Foreground="{StaticResource Brand.Primary}" />

                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{Binding}"
                                        FontSize="13"
                                        Foreground="{StaticResource Text.Primary}"
                                        TextWrapping="Wrap" />

                                </Grid>

                            </DataTemplate>

                        </ItemsControl.ItemTemplate>

                    </ItemsControl>

                </Border>

                <TextBlock
                    Text="{Binding Footer}"
                    Margin="0,20,0,0"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource Text.Secondary}"
                    TextWrapping="Wrap" />

                <!-- OPTIONALER HILFELINK -->

                <TextBlock
                    x:Name="ReleaseNotesActionText"
                    Margin="0,14,0,0"
                    FontSize="13"
                    TextWrapping="Wrap"
                    Visibility="Collapsed">

                    <Hyperlink
                        NavigateUri="{Binding ActionUri}"
                        Foreground="{StaticResource Brand.Primary}"
                        RequestNavigate="ReleaseNotesActionLink_OnRequestNavigate">

                        <Run Text="{Binding ActionText}" />

                    </Hyperlink>

                </TextBlock>

            </StackPanel>

        </ScrollViewer>

        <!-- FESTER SCHLIESSEN-BUTTON -->

        <Button
            Grid.Row="2"
            Width="120"
            Height="38"
            Margin="0,24,0,0"
            HorizontalAlignment="Right"
            Content="Alles klar"
            Cursor="Hand"
            Style="{StaticResource Button.Primary}"
            Click="CloseButton_OnClick" />

    </Grid>

</Window>