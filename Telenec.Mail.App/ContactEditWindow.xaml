<Window x:Class="Telenec.Mail.App.ContactEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Telenec Mail — Kontakt"
        Width="620"
        Height="570"
        MinWidth="560"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource Surface.Background}"
        Foreground="{StaticResource Text.Primary}"
        FontFamily="{StaticResource Typography.FontFamily}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid Margin="28">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- KOPF -->

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,20">

            <TextBlock
                x:Name="HeadingText"
                Text="Kontakt"
                FontSize="24"
                FontWeight="SemiBold"
                Foreground="{StaticResource Text.Primary}" />

            <TextBlock
                x:Name="SubtitleText"
                Margin="0,5,0,0"
                Text="Kontaktdaten bearbeiten"
                FontSize="12"
                Foreground="{StaticResource Text.Secondary}" />

        </StackPanel>

        <!-- FORMULAR -->

        <Border
            Grid.Row="1"
            Padding="22"
            Background="{StaticResource Surface.Card}"
            BorderBrush="{StaticResource Border.Default}"
            BorderThickness="1"
            CornerRadius="8">

            <ScrollViewer
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">

                <StackPanel>

                    <!-- NAME -->

                    <TextBlock
                        Text="Name"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource Text.Primary}" />

                    <Grid Margin="0,14,0,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">

                            <TextBlock
                                Text="Vorname"
                                Margin="0,0,0,5"
                                FontSize="12"
                                Foreground="{StaticResource Text.Secondary}" />

                            <TextBox
                                x:Name="FirstNameTextBox"
                                Height="36"
                                Padding="9,5" />

                        </StackPanel>

                        <StackPanel Grid.Column="2">

                            <TextBlock
                                Text="Nachname"
                                Margin="0,0,0,5"
                                FontSize="12"
                                Foreground="{StaticResource Text.Secondary}" />

                            <TextBox
                                x:Name="LastNameTextBox"
                                Height="36"
                                Padding="9,5" />

                        </StackPanel>

                    </Grid>

                    <TextBlock
                        Text="Anzeigename"
                        Margin="0,14,0,5"
                        FontSize="12"
                        Foreground="{StaticResource Text.Secondary}" />

                    <TextBox
                        x:Name="DisplayNameTextBox"
                        Height="36"
                        Padding="9,5" />

                    <!-- KONTAKT -->

                    <Border
                        Height="1"
                        Margin="0,22,0,20"
                        Background="{StaticResource Border.Default}" />

                    <TextBlock
                        Text="Kontakt"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource Text.Primary}" />

                    <TextBlock
                        Text="E-Mail-Adresse"
                        Margin="0,14,0,5"
                        FontSize="12"
                        Foreground="{StaticResource Text.Secondary}" />

                    <TextBox
                        x:Name="EmailAddressTextBox"
                        Height="36"
                        Padding="9,5" />

                    <TextBlock
                        Text="Telefon"
                        Margin="0,14,0,5"
                        FontSize="12"
                        Foreground="{StaticResource Text.Secondary}" />

                    <TextBox
                        x:Name="PhoneNumberTextBox"
                        Height="36"
                        Padding="9,5" />

                    <TextBlock
                        Margin="0,18,0,0"
                        Text="Weitere Angaben wie Firma, mehrere E-Mail-Adressen, Telefonnummern, Adressen, Gruppen und Foto folgen im nächsten Ausbau dieses Fensters."
                        FontSize="11"
                        TextWrapping="Wrap"
                        Foreground="{StaticResource Text.Secondary}" />

                </StackPanel>

            </ScrollViewer>

        </Border>

        <!-- BUTTONS -->

        <Grid
            Grid.Row="2"
            Margin="0,18,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button
                Grid.Column="1"
                Width="110"
                Height="38"
                Content="Abbrechen"
                IsCancel="True"
                Cursor="Hand"
                Click="CancelButton_OnClick" />

            <Button
                x:Name="SaveButton"
                Grid.Column="3"
                Height="38"
                MinWidth="140"
                Padding="16,0"
                Content="Speichern"
                IsDefault="True"
                Cursor="Hand"
                Style="{StaticResource Button.Primary}"
                Click="SaveButton_OnClick" />

        </Grid>

    </Grid>

</Window>