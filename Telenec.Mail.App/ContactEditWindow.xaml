<Window x:Class="Telenec.Mail.App.ContactEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Telenec Mail — Kontakt"
        Width="980"
        Height="820"
        MinWidth="800"
        MinHeight="650"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource Surface.Background}"
        Foreground="{StaticResource Text.Primary}"
        FontFamily="{StaticResource Typography.FontFamily}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>

        <Style x:Key="FormCard"
               TargetType="Border">

            <Setter
                Property="Padding"
                Value="20" />

            <Setter
                Property="Background"
                Value="{StaticResource Surface.Card}" />

            <Setter
                Property="BorderBrush"
                Value="{StaticResource Border.Default}" />

            <Setter
                Property="BorderThickness"
                Value="1" />

            <Setter
                Property="CornerRadius"
                Value="9" />

        </Style>

        <Style x:Key="FormSectionTitle"
               TargetType="TextBlock">

            <Setter
                Property="FontSize"
                Value="15" />

            <Setter
                Property="FontWeight"
                Value="SemiBold" />

            <Setter
                Property="Foreground"
                Value="{StaticResource Text.Primary}" />

            <Setter
                Property="Margin"
                Value="0,0,0,16" />

        </Style>

        <Style x:Key="FormLabel"
               TargetType="TextBlock">

            <Setter
                Property="FontSize"
                Value="11" />

            <Setter
                Property="Foreground"
                Value="{StaticResource Text.Secondary}" />

            <Setter
                Property="Margin"
                Value="0,0,0,5" />

        </Style>

        <Style x:Key="FormTextBox"
               TargetType="TextBox">

            <Setter
                Property="Height"
                Value="36" />

            <Setter
                Property="Padding"
                Value="9,5" />

        </Style>

    </Window.Resources>

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- KOPF -->

        <StackPanel
            Grid.Row="0"
            Margin="0,0,0,20">

            <TextBlock
                x:Name="HeadingText"
                Text="Kontakt"
                FontSize="26"
                FontWeight="SemiBold"
                Foreground="{StaticResource Text.Primary}" />

            <TextBlock
                x:Name="SubtitleText"
                Margin="0,5,0,0"
                Text="Kontaktdaten bearbeiten"
                FontSize="12"
                Foreground="{StaticResource Text.Secondary}" />

        </StackPanel>

        <!-- FORMULAR -->

        <ScrollViewer
            Grid.Row="1"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled">

            <StackPanel>

                <!-- FOTO + NAME -->

                <Border
                    Style="{StaticResource FormCard}"
                    Margin="0,0,0,16">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- FOTO -->

                        <StackPanel Grid.Column="0">

                            <TextBlock
                                Text="Kontaktfoto"
                                Style="{StaticResource FormSectionTitle}" />

                            <Grid
                                Width="112"
                                Height="112"
                                HorizontalAlignment="Left">

                                <Ellipse
                                    Fill="{StaticResource Surface.Background}"
                                    Stroke="{StaticResource Border.Default}"
                                    StrokeThickness="1" />

                                <Ellipse>

                                    <Ellipse.Fill>

                                        <ImageBrush
                                            x:Name="PhotoImageBrush"
                                            Stretch="UniformToFill" />

                                    </Ellipse.Fill>

                                </Ellipse>

                                <TextBlock
                                    x:Name="PhotoPlaceholder"
                                    Text="&#xE77B;"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="42"
                                    Foreground="{StaticResource Text.Secondary}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />

                            </Grid>

                            <Button
                                Margin="0,14,0,0"
                                Width="130"
                                Height="34"
                                HorizontalAlignment="Left"
                                Content="Foto auswählen"
                                Cursor="Hand"
                                Click="SelectPhotoButton_OnClick" />

                            <Button
                                x:Name="RemovePhotoButton"
                                Margin="0,8,0,0"
                                Width="130"
                                Height="34"
                                HorizontalAlignment="Left"
                                Content="Foto entfernen"
                                IsEnabled="False"
                                Cursor="Hand"
                                Click="RemovePhotoButton_OnClick" />

                        </StackPanel>

                        <!-- NAME -->

                        <StackPanel Grid.Column="2">

                            <TextBlock
                                Text="Name"
                                Style="{StaticResource FormSectionTitle}" />

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">

                                    <TextBlock
                                        Text="Anrede"
                                        Style="{StaticResource FormLabel}" />

                                    <TextBox
                                        x:Name="SalutationTextBox"
                                        Style="{StaticResource FormTextBox}" />

                                </StackPanel>

                                <StackPanel Grid.Column="2">

                                    <TextBlock
                                        Text="Titel"
                                        Style="{StaticResource FormLabel}" />

                                    <TextBox
                                        x:Name="AcademicTitleTextBox"
                                        Style="{StaticResource FormTextBox}" />

                                </StackPanel>

                            </Grid>

                            <Grid Margin="0,13,0,0">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">

                                    <TextBlock
                                        Text="Vorname"
                                        Style="{StaticResource FormLabel}" />

                                    <TextBox
                                        x:Name="FirstNameTextBox"
                                        Style="{StaticResource FormTextBox}" />

                                </StackPanel>

                                <StackPanel Grid.Column="2">

                                    <TextBlock
                                        Text="Zweiter Vorname"
                                        Style="{StaticResource FormLabel}" />

                                    <TextBox
                                        x:Name="MiddleNameTextBox"
                                        Style="{StaticResource FormTextBox}" />

                                </StackPanel>

                            </Grid>

                            <Grid Margin="0,13,0,0">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">

                                    <TextBlock
                                        Text="Nachname"
                                        Style="{StaticResource FormLabel}" />

                                    <TextBox
                                        x:Name="LastNameTextBox"
                                        Style="{StaticResource FormTextBox}" />

                                </StackPanel>

                                <StackPanel Grid.Column="2">

                                    <TextBlock
                                        Text="Namenszusatz"
                                        Style="{StaticResource FormLabel}" />

                                    <TextBox
                                        x:Name="NameSuffixTextBox"
                                        Style="{StaticResource FormTextBox}" />

                                </StackPanel>

                            </Grid>

                            <Grid Margin="0,13,0,0">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">

                                    <TextBlock
                                        Text="Spitzname"
                                        Style="{StaticResource FormLabel}" />

                                    <TextBox
                                        x:Name="NicknameTextBox"
                                        Style="{StaticResource FormTextBox}" />

                                </StackPanel>

                                <StackPanel Grid.Column="2">

                                    <TextBlock
                                        Text="Anzeigename"
                                        Style="{StaticResource FormLabel}" />

                                    <TextBox
                                        x:Name="DisplayNameTextBox"
                                        Style="{StaticResource FormTextBox}" />

                                </StackPanel>

                            </Grid>

                        </StackPanel>

                    </Grid>

                </Border>

                <!-- EMAIL + TELEFON -->

                <Grid Margin="0,0,0,16">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- EMAIL -->

                    <Border
                        Grid.Column="0"
                        Style="{StaticResource FormCard}">

                        <StackPanel>

                            <TextBlock
                                Text="E-Mail"
                                Style="{StaticResource FormSectionTitle}" />

                            <TextBlock
                                Text="Bevorzugte E-Mail-Adresse"
                                Style="{StaticResource FormLabel}" />

                            <TextBox
                                x:Name="EmailAddressTextBox"
                                Style="{StaticResource FormTextBox}" />

                            <Grid Margin="0,13,0,0">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">

                                    <TextBlock
                                        Text="Geschäftlich"
                                        Style="{StaticResource FormLabel}" />

                                    <TextBox
                                        x:Name="BusinessEmailAddressTextBox"
                                        Style="{StaticResource FormTextBox}" />

                                </StackPanel>

                                <StackPanel Grid.Column="2">

                                    <TextBlock
                                        Text="Privat"
                                        Style="{StaticResource FormLabel}" />

                                    <TextBox
                                        x:Name="PrivateEmailAddressTextBox"
                                        Style="{StaticResource FormTextBox}" />

                                </StackPanel>

                            </Grid>

                            <TextBlock
                                Margin="0,13,0,5"
                                Text="Weitere E-Mail-Adressen"
                                Style="{StaticResource FormLabel}" />

                            <TextBox
                                x:Name="AdditionalEmailAddressesTextBox"
                                Height="72"
                                Padding="9,7"
                                AcceptsReturn="True"
                                VerticalScrollBarVisibility="Auto"
                                ToolTip="Eine E-Mail-Adresse pro Zeile" />

                        </StackPanel>

                    </Border>

                    <!-- TELEFON -->

                    <Border
                        Grid.Column="2"
                        Style="{StaticResource FormCard}">

                        <StackPanel>

                            <TextBlock
                                Text="Telefon"
                                Style="{StaticResource FormSectionTitle}" />

                            <TextBlock
                                Text="Bevorzugte Telefonnummer"
                                Style="{StaticResource FormLabel}" />

                            <TextBox
                                x:Name="PhoneNumberTextBox"
                                Style="{StaticResource FormTextBox}" />

                            <Grid Margin="0,13,0,0">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">

                                    <TextBlock
                                        Text="Mobil"
                                        Style="{StaticResource FormLabel}" />

                                    <TextBox
                                        x:Name="MobilePhoneNumberTextBox"
                                        Style="{StaticResource FormTextBox}" />

                                </StackPanel>

                                <StackPanel Grid.Column="2">

                                    <TextBlock
                                        Text="Geschäftlich"
                                        Style="{StaticResource FormLabel}" />

                                    <TextBox
                                        x:Name="BusinessPhoneNumberTextBox"
                                        Style="{StaticResource FormTextBox}" />

                                </StackPanel>

                            </Grid>

                            <Grid Margin="0,13,0,0">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">

                                    <TextBlock
                                        Text="Privat"
                                        Style="{StaticResource FormLabel}" />

                                    <TextBox
                                        x:Name="PrivatePhoneNumberTextBox"
                                        Style="{StaticResource FormTextBox}" />

                                </StackPanel>

                                <StackPanel Grid.Column="2">

                                    <TextBlock
                                        Text="Fax"
                                        Style="{StaticResource FormLabel}" />

                                    <TextBox
                                        x:Name="FaxNumberTextBox"
                                        Style="{StaticResource FormTextBox}" />

                                </StackPanel>

                            </Grid>

                            <TextBlock
                                Margin="0,13,0,5"
                                Text="Weitere Telefonnummern"
                                Style="{StaticResource FormLabel}" />

                            <TextBox
                                x:Name="AdditionalPhoneNumbersTextBox"
                                Height="72"
                                Padding="9,7"
                                AcceptsReturn="True"
                                VerticalScrollBarVisibility="Auto"
                                ToolTip="Eine Telefonnummer pro Zeile" />

                        </StackPanel>

                    </Border>

                </Grid>

                <!-- BERUF + KATEGORIEN -->

                <Grid Margin="0,0,0,16">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- BERUF -->

                    <Border
                        Grid.Column="0"
                        Style="{StaticResource FormCard}">

                        <StackPanel>

                            <TextBlock
                                Text="Firma und Beruf"
                                Style="{StaticResource FormSectionTitle}" />

                            <TextBlock
                                Text="Firma"
                                Style="{StaticResource FormLabel}" />

                            <TextBox
                                x:Name="CompanyTextBox"
                                Style="{StaticResource FormTextBox}" />

                            <Grid Margin="0,13,0,0">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">

                                    <TextBlock
                                        Text="Abteilung"
                                        Style="{StaticResource FormLabel}" />

                                    <TextBox
                                        x:Name="DepartmentTextBox"
                                        Style="{StaticResource FormTextBox}" />

                                </StackPanel>

                                <StackPanel Grid.Column="2">

                                    <TextBlock
                                        Text="Position"
                                        Style="{StaticResource FormLabel}" />

                                    <TextBox
                                        x:Name="JobTitleTextBox"
                                        Style="{StaticResource FormTextBox}" />

                                </StackPanel>

                            </Grid>

                        </StackPanel>

                    </Border>

                    <!-- KATEGORIEN -->

                    <Border
                        Grid.Column="2"
                        Style="{StaticResource FormCard}">

                        <StackPanel>

                            <TextBlock
                                Text="Gruppen und Kategorien"
                                Style="{StaticResource FormSectionTitle}" />

                            <TextBlock
                                Text="Ein Klick auf das Feld öffnet die vorhandenen Kategorien. Dort können Zuordnungen an- oder ausgeschaltet und neue Kategorien angelegt werden."
                                FontSize="11"
                                TextWrapping="Wrap"
                                Foreground="{StaticResource Text.Secondary}"
                                Margin="0,0,0,14" />

                            <TextBlock
                                Text="Zugeordnet"
                                Style="{StaticResource FormLabel}" />

                            <TextBox
                                x:Name="CategoriesTextBox"
                                Height="42"
                                Padding="10,6"
                                VerticalContentAlignment="Center"
                                ToolTip="Klicken, um Kategorien auszuwählen" />

                        </StackPanel>

                    </Border>

                </Grid>

                <!-- ADRESSEN -->

                <Grid Margin="0,0,0,16">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- PRIVAT -->

                    <Border
                        Grid.Column="0"
                        Style="{StaticResource FormCard}">

                        <StackPanel>

                            <TextBlock
                                Text="Private Adresse"
                                Style="{StaticResource FormSectionTitle}" />

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">

                                    <TextBlock
                                        Text="Postfach"
                                        Style="{StaticResource FormLabel}" />

                                    <TextBox
                                        x:Name="HomePostOfficeBoxTextBox"
                                        Style="{StaticResource FormTextBox}" />

                                </StackPanel>

                                <StackPanel Grid.Column="2">

                                    <TextBlock
                                        Text="Adresszusatz"
                                        Style="{StaticResource FormLabel}" />

                                    <TextBox
                                        x:Name="HomeExtendedAddressTextBox"
                                        Style="{StaticResource FormTextBox}" />

                                </StackPanel>

                            </Grid>

                            <TextBlock
                                Margin="0,13,0,5"
                                Text="Straße"
                                Style="{StaticResource FormLabel}" />

                            <TextBox
                                x:Name="HomeStreetTextBox"
                                Style="{StaticResource FormTextBox}" />

                            <Grid Margin="0,13,0,0">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">

                                    <TextBlock
                                        Text="PLZ"
                                        Style="{StaticResource FormLabel}" />

                                    <TextBox
                                        x:Name="HomePostalCodeTextBox"
                                        Style="{StaticResource FormTextBox}" />

                                </StackPanel>

                                <StackPanel Grid.Column="2">

                                    <TextBlock
                                        Text="Ort"
                                        Style="{StaticResource FormLabel}" />

                                    <TextBox
                                        x:Name="HomeCityTextBox"
                                        Style="{StaticResource FormTextBox}" />

                                </StackPanel>

                            </Grid>

                            <Grid Margin="0,13,0,0">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">

                                    <TextBlock
                                        Text="Bundesland / Region"
                                        Style="{StaticResource FormLabel}" />

                                    <TextBox
                                        x:Name="HomeRegionTextBox"
                                        Style="{StaticResource FormTextBox}" />

                                </StackPanel>

                                <StackPanel Grid.Column="2">

                                    <TextBlock
                                        Text="Land"
                                        Style="{StaticResource FormLabel}" />

                                    <TextBox
                                        x:Name="HomeCountryTextBox"
                                        Style="{StaticResource FormTextBox}" />

                                </StackPanel>

                            </Grid>

                        </StackPanel>

                    </Border>

                    <!-- GESCHÄFTLICH -->

                    <Border
                        Grid.Column="2"
                        Style="{StaticResource FormCard}">

                        <StackPanel>

                            <TextBlock
                                Text="Geschäftliche Adresse"
                                Style="{StaticResource FormSectionTitle}" />

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">

                                    <TextBlock
                                        Text="Postfach"
                                        Style="{StaticResource FormLabel}" />

                                    <TextBox
                                        x:Name="WorkPostOfficeBoxTextBox"
                                        Style="{StaticResource FormTextBox}" />

                                </StackPanel>

                                <StackPanel Grid.Column="2">

                                    <TextBlock
                                        Text="Adresszusatz"
                                        Style="{StaticResource FormLabel}" />

                                    <TextBox
                                        x:Name="WorkExtendedAddressTextBox"
                                        Style="{StaticResource FormTextBox}" />

                                </StackPanel>

                            </Grid>

                            <TextBlock
                                Margin="0,13,0,5"
                                Text="Straße"
                                Style="{StaticResource FormLabel}" />

                            <TextBox
                                x:Name="WorkStreetTextBox"
                                Style="{StaticResource FormTextBox}" />

                            <Grid Margin="0,13,0,0">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">

                                    <TextBlock
                                        Text="PLZ"
                                        Style="{StaticResource FormLabel}" />

                                    <TextBox
                                        x:Name="WorkPostalCodeTextBox"
                                        Style="{StaticResource FormTextBox}" />

                                </StackPanel>

                                <StackPanel Grid.Column="2">

                                    <TextBlock
                                        Text="Ort"
                                        Style="{StaticResource FormLabel}" />

                                    <TextBox
                                        x:Name="WorkCityTextBox"
                                        Style="{StaticResource FormTextBox}" />

                                </StackPanel>

                            </Grid>

                            <Grid Margin="0,13,0,0">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">

                                    <TextBlock
                                        Text="Bundesland / Region"
                                        Style="{StaticResource FormLabel}" />

                                    <TextBox
                                        x:Name="WorkRegionTextBox"
                                        Style="{StaticResource FormTextBox}" />

                                </StackPanel>

                                <StackPanel Grid.Column="2">

                                    <TextBlock
                                        Text="Land"
                                        Style="{StaticResource FormLabel}" />

                                    <TextBox
                                        x:Name="WorkCountryTextBox"
                                        Style="{StaticResource FormTextBox}" />

                                </StackPanel>

                            </Grid>

                        </StackPanel>

                    </Border>

                </Grid>

                <!-- WEITERE ANGABEN -->

                <Border
                    Style="{StaticResource FormCard}">

                    <StackPanel>

                        <TextBlock
                            Text="Weitere Angaben"
                            Style="{StaticResource FormSectionTitle}" />

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">

                                <TextBlock
                                    Text="Website"
                                    Style="{StaticResource FormLabel}" />

                                <TextBox
                                    x:Name="WebsiteTextBox"
                                    Style="{StaticResource FormTextBox}" />

                            </StackPanel>

                            <StackPanel Grid.Column="2">

                                <TextBlock
                                    Text="Geburtstag"
                                    Style="{StaticResource FormLabel}" />

                                <TextBox
                                    x:Name="BirthdayTextBox"
                                    Style="{StaticResource FormTextBox}"
                                    ToolTip="Beispiel: 1986-07-31" />

                            </StackPanel>

                        </Grid>

                        <TextBlock
                            Margin="0,13,0,5"
                            Text="Notizen"
                            Style="{StaticResource FormLabel}" />

                        <TextBox
                            x:Name="NotesTextBox"
                            Height="120"
                            Padding="9,7"
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            VerticalScrollBarVisibility="Auto" />

                    </StackPanel>

                </Border>

            </StackPanel>

        </ScrollViewer>

        <!-- BUTTONS -->

        <Grid
            Grid.Row="2"
            Margin="0,20,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button
                Grid.Column="1"
                Width="115"
                Height="40"
                Content="Abbrechen"
                IsCancel="True"
                Cursor="Hand"
                Click="CancelButton_OnClick" />

            <Button
                x:Name="SaveButton"
                Grid.Column="3"
                Height="40"
                MinWidth="160"
                Padding="18,0"
                Content="Speichern"
                IsDefault="True"
                Cursor="Hand"
                Style="{StaticResource Button.Primary}"
                Click="SaveButton_OnClick" />

        </Grid>

    </Grid>

</Window>