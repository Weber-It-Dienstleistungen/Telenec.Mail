<Window x:Class="Telenec.Mail.App.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Passwort ändern"
        Width="520"
        Height="690"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource Surface.Background}"
        Foreground="{StaticResource Text.Primary}"
        FontFamily="{StaticResource Typography.FontFamily}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Closing="ChangePasswordWindow_OnClosing">

    <ScrollViewer
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled">

        <Grid MinHeight="650">

            <Border
                Width="400"
                Margin="0,24"
                Padding="36"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{StaticResource Surface.Card}"
                BorderBrush="{StaticResource Border.Default}"
                BorderThickness="1"
                CornerRadius="12">

                <StackPanel>

                    <Image
                        Source="/Assets/Brand/TelenecMailLogo.png"
                        Width="300"
                        Height="90"
                        Margin="0,0,0,22"
                        Stretch="Uniform" />

                    <TextBlock
                        Text="Passwort ändern"
                        HorizontalAlignment="Center"
                        FontSize="24"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource Text.Primary}" />

                    <TextBlock
                        x:Name="AccountEmailText"
                        Margin="0,8,0,24"
                        HorizontalAlignment="Center"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        FontSize="13"
                        Foreground="{StaticResource Text.Secondary}" />

                    <StackPanel
                        x:Name="PasswordFieldsPanel">

                        <TextBlock
                            Text="Aktuelles Passwort"
                            Margin="0,0,0,6"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource Text.Primary}" />

                        <PasswordBox
                            x:Name="CurrentPasswordInput"
                            PasswordChanged="PasswordInput_OnPasswordChanged"
                            Height="42"
                            Padding="11,8"
                            Margin="0,0,0,16"
                            VerticalContentAlignment="Center"
                            FontSize="14"
                            BorderBrush="{StaticResource Border.Default}"
                            BorderThickness="1" />

                        <TextBlock
                            Text="Neues Passwort"
                            Margin="0,0,0,6"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource Text.Primary}" />

                        <PasswordBox
                            x:Name="NewPasswordInput"
                            PasswordChanged="PasswordInput_OnPasswordChanged"
                            Height="42"
                            Padding="11,8"
                            Margin="0,0,0,16"
                            VerticalContentAlignment="Center"
                            FontSize="14"
                            BorderBrush="{StaticResource Border.Default}"
                            BorderThickness="1" />

                        <TextBlock
                            Text="Neues Passwort wiederholen"
                            Margin="0,0,0,6"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource Text.Primary}" />

                        <PasswordBox
                            x:Name="ConfirmPasswordInput"
                            PasswordChanged="PasswordInput_OnPasswordChanged"
                            Height="42"
                            Padding="11,8"
                            Margin="0,0,0,20"
                            VerticalContentAlignment="Center"
                            FontSize="14"
                            BorderBrush="{StaticResource Border.Default}"
                            BorderThickness="1" />

                    </StackPanel>

                    <Border
                        Margin="0,0,0,18"
                        Padding="12"
                        Background="{StaticResource Surface.Background}"
                        BorderBrush="{StaticResource Border.Default}"
                        BorderThickness="1"
                        CornerRadius="6">

                        <TextBlock
                            Text="Nach erfolgreicher Änderung aktualisiert Telenec Mail die gespeicherten Zugangsdaten automatisch."
                            TextWrapping="Wrap"
                            FontSize="11"
                            Foreground="{StaticResource Text.Secondary}" />

                    </Border>

                    <Button
                        x:Name="ChangeButton"
                        Click="ChangeButton_OnClick"
                        IsDefault="True"
                        Height="44"
                        Background="{StaticResource Brand.Primary}"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Content="Passwort ändern" />

                    <Button
                        x:Name="CancelButton"
                        Click="CancelButton_OnClick"
                        IsCancel="True"
                        Height="40"
                        Margin="0,10,0,0"
                        Background="Transparent"
                        Foreground="{StaticResource Text.Secondary}"
                        BorderBrush="{StaticResource Border.Default}"
                        BorderThickness="1"
                        FontSize="13"
                        Content="Abbrechen" />

                    <TextBlock
                        x:Name="StatusText"
                        MinHeight="44"
                        Margin="0,14,0,0"
                        HorizontalAlignment="Center"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        FontSize="12"
                        Foreground="{StaticResource Text.Secondary}" />

                </StackPanel>

            </Border>

        </Grid>

    </ScrollViewer>

</Window>