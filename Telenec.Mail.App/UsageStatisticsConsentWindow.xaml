<Window x:Class="Telenec.Mail.App.UsageStatisticsConsentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Telenec Mail – Freiwillige Nutzungsstatistik"
        Width="620"
        Height="650"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource Surface.Background}"
        Foreground="{StaticResource Text.Primary}"
        FontFamily="{StaticResource Typography.FontFamily}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>

        <Style
            x:Key="ConsentSecondaryButton"
            TargetType="Button">

            <Setter
                Property="Background"
                Value="{StaticResource Surface.Card}" />

            <Setter
                Property="Foreground"
                Value="{StaticResource Text.Primary}" />

            <Setter
                Property="BorderBrush"
                Value="{StaticResource Border.Default}" />

            <Setter
                Property="BorderThickness"
                Value="1" />

            <Setter
                Property="Padding"
                Value="16,8" />

            <Setter
                Property="MinHeight"
                Value="38" />

            <Setter
                Property="FontWeight"
                Value="SemiBold" />

            <Setter
                Property="Cursor"
                Value="Hand" />

        </Style>

    </Window.Resources>

    <Grid Margin="32">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- KOPF -->

        <StackPanel Grid.Row="0">

            <Image
                Source="/Assets/Brand/TelenecMailLogo.png"
                Width="250"
                Margin="0,0,0,24"
                HorizontalAlignment="Left"
                Stretch="Uniform" />

            <TextBlock
                Text="Freiwillige Nutzungsstatistik"
                FontSize="24"
                FontWeight="SemiBold"
                Foreground="{StaticResource Text.Primary}" />

            <TextBlock
                Margin="0,8,0,0"
                Text="Möchten Sie uns dabei helfen, die Verbreitung und Aktualität von Telenec Mail besser einzuschätzen?"
                FontSize="13"
                Foreground="{StaticResource Text.Secondary}"
                TextWrapping="Wrap" />

        </StackPanel>

        <!-- INFORMATIONEN -->

        <ScrollViewer
            Grid.Row="1"
            Margin="0,24,0,0"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled">

            <StackPanel>

                <Border
                    Padding="20"
                    Background="{StaticResource Surface.Card}"
                    BorderBrush="{StaticResource Border.Default}"
                    BorderThickness="1"
                    CornerRadius="8">

                    <StackPanel>

                        <TextBlock
                            Text="Bei Ihrer Zustimmung dürfen für die Nutzungsstatistik ausschließlich folgende Angaben verwendet werden:"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource Text.Primary}"
                            TextWrapping="Wrap" />

                        <TextBlock
                            Margin="0,14,0,0"
                            Text="• eine zufällig erzeugte Installations-ID"
                            FontSize="13"
                            Foreground="{StaticResource Text.Primary}"
                            TextWrapping="Wrap" />

                        <TextBlock
                            Margin="0,7,0,0"
                            Text="• die verwendete Version von Telenec Mail"
                            FontSize="13"
                            Foreground="{StaticResource Text.Primary}"
                            TextWrapping="Wrap" />

                        <TextBlock
                            Margin="0,7,0,0"
                            Text="• der Zeitpunkt einer Statistikmeldung bzw. des letzten Kontakts"
                            FontSize="13"
                            Foreground="{StaticResource Text.Primary}"
                            TextWrapping="Wrap" />

                    </StackPanel>

                </Border>

                <TextBlock
                    Margin="0,20,0,0"
                    FontSize="13"
                    Foreground="{StaticResource Text.Secondary}"
                    TextWrapping="Wrap">
                    <Run Text="Nicht verwendet werden E-Mail-Adresse, Name, Kontodaten, E-Mail-Inhalte, Kontakte, Hardwaredaten oder andere Nutzinhalte. " />
                    <Run Text="Die Installations-ID wird nicht aus Kunden-, Konto- oder Gerätedaten abgeleitet." />
                </TextBlock>

                <TextBlock
                    Margin="0,14,0,0"
                    Text="Die zufällige Installations-ID wird erst erzeugt, nachdem Sie ausdrücklich zugestimmt haben."
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource Text.Primary}"
                    TextWrapping="Wrap" />

                <Border
                    Margin="0,20,0,0"
                    Padding="16"
                    Background="{StaticResource Brand.PrimaryLight}"
                    CornerRadius="6">

                    <TextBlock
                        FontSize="12"
                        Foreground="{StaticResource Text.Primary}"
                        TextWrapping="Wrap">
                        <Run Text="Die Teilnahme ist freiwillig. " />
                        <Run Text="Wenn Sie nicht teilnehmen möchten, können Sie Telenec Mail ohne Einschränkungen verwenden. " />
                        <Run Text="Ihre Entscheidung können Sie später jederzeit unter Einstellungen → Allgemein ändern." />
                    </TextBlock>

                </Border>

            </StackPanel>

        </ScrollViewer>

        <!-- ENTSCHEIDUNG -->

        <Grid
            Grid.Row="2"
            Margin="0,26,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button
                Grid.Column="1"
                Width="150"
                Height="40"
                Margin="0,0,10,0"
                Content="Nicht teilnehmen"
                IsCancel="True"
                Style="{StaticResource ConsentSecondaryButton}"
                Click="DeclineButton_OnClick" />

            <Button
                Grid.Column="2"
                Width="150"
                Height="40"
                Content="Zustimmen"
                Style="{StaticResource Button.Primary}"
                Click="GrantButton_OnClick" />

        </Grid>

    </Grid>

</Window>