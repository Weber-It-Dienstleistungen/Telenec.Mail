<Window x:Class="Telenec.Mail.App.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Telenec Mail"
        Width="520"
        Height="680"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Surface.Background}"
        Foreground="{StaticResource Text.Primary}"
        FontFamily="{StaticResource Typography.FontFamily}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <ScrollViewer
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled">

        <Grid MinHeight="640">

            <Border
                Width="400"
                Margin="0,24"
                Padding="36"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{StaticResource Surface.Card}"
                BorderBrush="{StaticResource Border.Default}"
                BorderThickness="1"
                CornerRadius="12">

                <StackPanel>

                    <Image
                        Source="/Assets/Brand/TelenecMailLogo.png"
                        Width="300"
                        Height="90"
                        Margin="0,0,0,22"
                        Stretch="Uniform" />

                    <TextBlock
                        Text="Willkommen"
                        HorizontalAlignment="Center"
                        FontSize="24"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource Text.Primary}" />

                    <TextBlock
                        Text="Melden Sie sich mit Ihrer Telenec-E-Mail-Adresse an."
                        Margin="0,8,0,24"
                        HorizontalAlignment="Center"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        FontSize="13"
                        Foreground="{StaticResource Text.Secondary}" />

                    <TextBlock
                        Text="E-Mail-Adresse"
                        Margin="0,0,0,6"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource Text.Primary}" />

                    <TextBox
                        Text="{Binding EmailAddress, UpdateSourceTrigger=PropertyChanged}"
                        Height="42"
                        Padding="11,8"
                        Margin="0,0,0,16"
                        VerticalContentAlignment="Center"
                        FontSize="14"
                        BorderBrush="{StaticResource Border.Default}"
                        BorderThickness="1" />

                    <TextBlock
                        Text="Passwort"
                        Margin="0,0,0,6"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource Text.Primary}" />

                    <PasswordBox
                        x:Name="PasswordInput"
                        PasswordChanged="PasswordInput_OnPasswordChanged"
                        Height="42"
                        Padding="11,8"
                        Margin="0,0,0,20"
                        VerticalContentAlignment="Center"
                        FontSize="14"
                        BorderBrush="{StaticResource Border.Default}"
                        BorderThickness="1" />

                    <Button
                        x:Name="LoginButton"
                        Click="LoginButton_OnClick"
                        Height="44"
                        IsEnabled="{Binding CanLogin}"
                        Background="{StaticResource Brand.Primary}"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Content="{Binding LoginButtonText}" />

                    <TextBlock
                        Text="{Binding StatusMessage}"
                        MinHeight="44"
                        Margin="0,14,0,0"
                        HorizontalAlignment="Center"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        FontSize="12"
                        Foreground="{StaticResource Text.Secondary}" />

                    <TextBlock
                        Text="Die Servereinstellungen werden automatisch eingerichtet."
                        Margin="0,8,0,0"
                        HorizontalAlignment="Center"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        FontSize="11"
                        Foreground="{StaticResource Text.Muted}" />

                </StackPanel>

            </Border>

        </Grid>

    </ScrollViewer>

</Window>