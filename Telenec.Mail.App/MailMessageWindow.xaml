<Window x:Class="Telenec.Mail.App.MailMessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="{Binding Subject}"
        Width="900"
        Height="700"
        MinWidth="620"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Surface.Background}">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Kopfbereich -->

        <Border
            Grid.Row="0"
            Padding="24,20"
            Background="{StaticResource Surface.Card}"
            BorderBrush="{StaticResource Border.Default}"
            BorderThickness="0,0,0,1">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    Width="44"
                    Height="44"
                    Margin="0,0,14,0"
                    CornerRadius="22"
                    Background="{StaticResource Brand.Primary}"
                    VerticalAlignment="Top">

                    <TextBlock
                        Text="{Binding SenderInitial}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="White" />

                </Border>

                <StackPanel
                    Grid.Column="1">

                    <TextBox
                        Text="{Binding Subject, Mode=OneWay}"
                        Padding="0"
                        BorderThickness="0"
                        Background="Transparent"
                        IsReadOnly="True"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource Text.Primary}"
                        TextWrapping="Wrap" />

                    <Grid Margin="0,12,0,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">

                            <TextBox
                                Text="{Binding Sender, Mode=OneWay}"
                                Padding="0"
                                BorderThickness="0"
                                Background="Transparent"
                                IsReadOnly="True"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource Text.Primary}" />

                            <TextBox
                                Text="{Binding SenderAddress, Mode=OneWay}"
                                Margin="0,3,0,0"
                                Padding="0"
                                BorderThickness="0"
                                Background="Transparent"
                                IsReadOnly="True"
                                FontSize="12"
                                Foreground="{StaticResource Text.Secondary}" />

                            <TextBox
                                Text="{Binding RecipientAddress, Mode=OneWay, StringFormat=An: {0}}"
                                Margin="0,3,0,0"
                                Padding="0"
                                BorderThickness="0"
                                Background="Transparent"
                                IsReadOnly="True"
                                FontSize="12"
                                Foreground="{StaticResource Text.Secondary}" />

                        </StackPanel>

                        <TextBlock
                            Grid.Column="1"
                            Text="{Binding DisplayDateTime}"
                            Margin="16,0,0,0"
                            FontSize="12"
                            Foreground="{StaticResource Text.Secondary}"
                            VerticalAlignment="Top" />

                    </Grid>

                </StackPanel>

            </Grid>

        </Border>

        <!-- Nachrichtenaktionen -->

        <Border
            x:Name="MessageActionsBar"
            Grid.Row="1"
            Visibility="Collapsed"
            Padding="24,10"
            Background="{StaticResource Surface.Card}"
            BorderBrush="{StaticResource Border.Default}"
            BorderThickness="0,0,0,1">

            <WrapPanel>

                <Button
                    x:Name="ReplyButton"
                    MinWidth="105"
                    Height="36"
                    Margin="0,0,8,4"
                    Padding="14,0"
                    Content="Antworten"
                    Cursor="Hand"
                    Style="{StaticResource Button.Primary}"
                    Click="ReplyButton_OnClick" />

                <Button
                    x:Name="ReplyAllButton"
                    MinWidth="125"
                    Height="36"
                    Margin="0,0,8,4"
                    Padding="14,0"
                    Content="Allen antworten"
                    Cursor="Hand"
                    Click="ReplyAllButton_OnClick" />

                <Button
                    x:Name="ForwardButton"
                    MinWidth="115"
                    Height="36"
                    Margin="0,0,8,4"
                    Padding="14,0"
                    Content="Weiterleiten"
                    Cursor="Hand"
                    Click="ForwardButton_OnClick" />

                <Button
                    x:Name="PrimaryMessageActionButton"
                    MinWidth="110"
                    Height="36"
                    Margin="0,0,8,4"
                    Padding="14,0"
                    Content="Löschen"
                    Cursor="Hand"
                    Click="PrimaryMessageActionButton_OnClick" />

                <Button
                    x:Name="PermanentDeleteButton"
                    MinWidth="130"
                    Height="36"
                    Margin="0,0,8,4"
                    Padding="14,0"
                    Content="Endgültig löschen"
                    Cursor="Hand"
                    Visibility="Collapsed"
                    Foreground="{StaticResource Status.Error}"
                    Click="PermanentDeleteButton_OnClick" />

                <Button
                    x:Name="PrintButton"
                    MinWidth="100"
                    Height="36"
                    Margin="0,0,0,4"
                    Padding="14,0"
                    Content="Drucken"
                    Cursor="Hand"
                    Click="PrintButton_OnClick" />

            </WrapPanel>

        </Border>

        <!-- Hinweis auf blockierte externe Bilder -->

        <Border
            x:Name="ExternalImagesNotice"
            Grid.Row="2"
            Visibility="Collapsed"
            Padding="16,10"
            Background="{StaticResource Brand.PrimaryLight}"
            BorderBrush="{StaticResource Border.Default}"
            BorderThickness="0,0,0,1">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    Text="&#xE7BA;"
                    Margin="0,0,10,0"
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="18"
                    Foreground="{StaticResource Brand.Primary}"
                    VerticalAlignment="Center" />

                <StackPanel
                    Grid.Column="1">

                    <TextBlock
                        Text="Externe Bilder wurden blockiert."
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource Text.Primary}" />

                    <TextBlock
                        Text="Zum Schutz Ihrer Privatsphäre lädt Telenec Mail externe Bilder nicht automatisch."
                        Margin="0,2,12,0"
                        FontSize="11"
                        Foreground="{StaticResource Text.Secondary}"
                        TextWrapping="Wrap" />

                </StackPanel>

                <Button
                    Grid.Column="2"
                    Content="Trotzdem laden"
                    Margin="12,0,0,0"
                    Padding="12,6"
                    VerticalAlignment="Center"
                    Cursor="Hand"
                    Style="{StaticResource Button.Primary}"
                    Click="LoadExternalImagesButton_OnClick" />

            </Grid>

        </Border>

        <!-- Nachricht -->

        <Grid Grid.Row="3">

            <!-- Plaintext-Fallback -->

            <ScrollViewer
                x:Name="PlainTextMailView"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">

                <StackPanel
                    Margin="36,30,36,40"
                    MaxWidth="820"
                    HorizontalAlignment="Left">

                    <TextBox
                        Text="{Binding Greeting, Mode=OneWay}"
                        Padding="0"
                        BorderThickness="0"
                        Background="Transparent"
                        IsReadOnly="True"
                        FontSize="14"
                        Foreground="{StaticResource Text.Primary}"
                        TextWrapping="Wrap"
                        AcceptsReturn="True" />

                    <TextBox
                        Text="{Binding Body, Mode=OneWay}"
                        Margin="0,18,0,0"
                        Padding="0"
                        BorderThickness="0"
                        Background="Transparent"
                        IsReadOnly="True"
                        FontSize="14"
                        Foreground="{StaticResource Text.Primary}"
                        TextWrapping="Wrap"
                        AcceptsReturn="True" />

                    <Border
                        Margin="0,24,0,24"
                        Padding="16"
                        CornerRadius="8"
                        Background="{StaticResource Brand.PrimaryLight}">

                        <Border.Style>

                            <Style TargetType="Border">

                                <Setter
                                    Property="Visibility"
                                    Value="Collapsed" />

                                <Style.Triggers>

                                    <DataTrigger
                                        Binding="{Binding HasHighlight}"
                                        Value="True">

                                        <Setter
                                            Property="Visibility"
                                            Value="Visible" />

                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>

                        </Border.Style>

                        <StackPanel>

                            <TextBox
                                Text="{Binding HighlightTitle, Mode=OneWay}"
                                Padding="0"
                                BorderThickness="0"
                                Background="Transparent"
                                IsReadOnly="True"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource Text.Primary}" />

                            <TextBox
                                Text="{Binding HighlightText, Mode=OneWay}"
                                Margin="0,6,0,0"
                                Padding="0"
                                BorderThickness="0"
                                Background="Transparent"
                                IsReadOnly="True"
                                FontSize="12"
                                Foreground="{StaticResource Text.Secondary}"
                                TextWrapping="Wrap"
                                AcceptsReturn="True" />

                        </StackPanel>

                    </Border>

                    <TextBox
                        Text="{Binding Closing, Mode=OneWay}"
                        Padding="0"
                        BorderThickness="0"
                        Background="Transparent"
                        IsReadOnly="True"
                        FontSize="14"
                        Foreground="{StaticResource Text.Primary}"
                        TextWrapping="Wrap"
                        AcceptsReturn="True" />

                    <TextBox
                        Text="{Binding Signature, Mode=OneWay}"
                        Margin="0,5,0,0"
                        Padding="0"
                        BorderThickness="0"
                        Background="Transparent"
                        IsReadOnly="True"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource Text.Primary}"
                        TextWrapping="Wrap"
                        AcceptsReturn="True" />

                </StackPanel>

            </ScrollViewer>

            <!-- HTML-Mail -->

            <wv2:WebView2
                x:Name="HtmlMailView"
                Visibility="Collapsed" />

        </Grid>

    </Grid>

</Window>