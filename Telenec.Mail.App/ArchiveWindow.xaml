<Window x:Class="Telenec.Mail.App.ArchiveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Telenec Mail – Lokales Archiv"
        Width="1100"
        Height="720"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource Surface.Background}"
        Foreground="{StaticResource Text.Primary}"
        FontFamily="{StaticResource Typography.FontFamily}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Loaded="ArchiveWindow_OnLoaded">

    <Window.Resources>

        <Style
            x:Key="ArchiveListItemStyle"
            TargetType="ListBoxItem">

            <Setter
                Property="HorizontalContentAlignment"
                Value="Stretch" />

            <Setter
                Property="Background"
                Value="Transparent" />

            <Setter
                Property="BorderThickness"
                Value="0" />

            <Setter
                Property="Padding"
                Value="0" />

            <Setter
                Property="Margin"
                Value="0" />

            <Setter
                Property="Focusable"
                Value="False" />

        </Style>

    </Window.Resources>

    <Grid Margin="28">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- KOPFBEREICH -->

        <Grid Grid.Row="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>

                <TextBlock
                    Text="Lokales Mailarchiv"
                    FontSize="26"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource Text.Primary}" />

                <TextBlock
                    Text="{Binding Location.EmailAddress}"
                    Margin="0,6,0,0"
                    FontSize="13"
                    Foreground="{StaticResource Text.Secondary}" />

            </StackPanel>

            <Image
                Grid.Column="1"
                Source="/Assets/Brand/TelenecMailLogo.png"
                Width="190"
                HorizontalAlignment="Right"
                Stretch="Uniform" />

        </Grid>

        <!-- ZUSAMMENFASSUNG -->

        <Border
            Grid.Row="1"
            Margin="0,24,0,20"
            Padding="20,16"
            Background="{StaticResource Surface.Card}"
            BorderBrush="{StaticResource Border.Default}"
            BorderThickness="1"
            CornerRadius="8">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    Margin="0,0,40,0">

                    <TextBlock
                        Text="Ordner"
                        FontSize="11"
                        Foreground="{StaticResource Text.Secondary}" />

                    <TextBlock
                        Text="{Binding FolderCount}"
                        Margin="0,3,0,0"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource Text.Primary}" />

                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    Margin="0,0,40,0">

                    <TextBlock
                        Text="Archivierte Nachrichten"
                        FontSize="11"
                        Foreground="{StaticResource Text.Secondary}" />

                    <TextBlock
                        Text="{Binding MessageCount}"
                        Margin="0,3,0,0"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource Text.Primary}" />

                </StackPanel>

                <StackPanel Grid.Column="2">

                    <TextBlock
                        Text="Dateiprüfung"
                        FontSize="11"
                        Foreground="{StaticResource Text.Secondary}" />

                    <TextBlock
                        Margin="0,3,0,0"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource Text.Primary}">

                        <TextBlock.Style>

                            <Style TargetType="TextBlock">

                                <Setter
                                    Property="Text"
                                    Value="Archivdateien vollständig" />

                                <Style.Triggers>

                                    <DataTrigger
                                        Binding="{Binding MissingFileCount}"
                                        Value="1">

                                        <Setter
                                            Property="Text"
                                            Value="1 Datei auffällig" />

                                        <Setter
                                            Property="Foreground"
                                            Value="{StaticResource Status.Warning}" />

                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>

                        </TextBlock.Style>

                    </TextBlock>

                    <TextBlock
                        Text="{Binding MissingFileCount, StringFormat={}{0} auffällige Datei(en)}"
                        Margin="0,3,0,0"
                        FontSize="11"
                        Foreground="{StaticResource Text.Secondary}">

                        <TextBlock.Style>

                            <Style TargetType="TextBlock">

                                <Setter
                                    Property="Visibility"
                                    Value="Visible" />

                                <Style.Triggers>

                                    <DataTrigger
                                        Binding="{Binding MissingFileCount}"
                                        Value="0">

                                        <Setter
                                            Property="Visibility"
                                            Value="Collapsed" />

                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>

                        </TextBlock.Style>

                    </TextBlock>

                </StackPanel>

            </Grid>

        </Border>

        <!-- ARCHIVINHALT -->

        <Grid
            x:Name="ArchiveContentGrid"
            Grid.Row="2"
            Visibility="Collapsed">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ORDNER -->

            <Border
                Grid.Column="0"
                Background="{StaticResource Surface.Card}"
                BorderBrush="{StaticResource Border.Default}"
                BorderThickness="1"
                CornerRadius="8">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border
                        Grid.Row="0"
                        Padding="18,15"
                        BorderBrush="{StaticResource Border.Default}"
                        BorderThickness="0,0,0,1">

                        <TextBlock
                            Text="Archivordner"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource Text.Primary}" />

                    </Border>

                    <ListBox
                        Grid.Row="1"
                        ItemsSource="{Binding Folders}"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="10"
                        ItemContainerStyle="{StaticResource ArchiveListItemStyle}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Auto">

                        <ListBox.ItemTemplate>

                            <DataTemplate>

                                <Border
                                    Margin="0,2"
                                    Padding="10,9"
                                    Background="{StaticResource Surface.Background}"
                                    CornerRadius="5">

                                    <Grid>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>

                                            <TextBlock
                                                Text="{Binding DisplayName}"
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                Foreground="{StaticResource Text.Primary}"
                                                TextTrimming="CharacterEllipsis" />

                                            <TextBlock
                                                Text="{Binding RelativeFolderPath}"
                                                Margin="0,3,0,0"
                                                FontSize="10"
                                                Foreground="{StaticResource Text.Secondary}"
                                                TextTrimming="CharacterEllipsis" />

                                        </StackPanel>

                                        <Border
                                            Grid.Column="1"
                                            MinWidth="32"
                                            Height="24"
                                            Margin="10,0,0,0"
                                            Padding="8,0"
                                            VerticalAlignment="Center"
                                            Background="#E8F1FB"
                                            BorderBrush="#B7D3F2"
                                            BorderThickness="1"
                                            CornerRadius="12">

                                            <TextBlock
                                                Text="{Binding DirectMessageCount}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Foreground="#0D5EA8" />

                                        </Border>

                                    </Grid>

                                </Border>

                            </DataTemplate>

                        </ListBox.ItemTemplate>

                    </ListBox>

                </Grid>

            </Border>

            <!-- NACHRICHTEN -->

            <Border
                Grid.Column="2"
                Background="{StaticResource Surface.Card}"
                BorderBrush="{StaticResource Border.Default}"
                BorderThickness="1"
                CornerRadius="8">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border
                        Grid.Row="0"
                        Padding="18,15"
                        BorderBrush="{StaticResource Border.Default}"
                        BorderThickness="0,0,0,1">

                        <TextBlock
                            Text="Archivierte Nachrichten"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource Text.Primary}" />

                    </Border>

                    <ListBox
                        Grid.Row="1"
                        ItemsSource="{Binding Messages}"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="10"
                        ItemContainerStyle="{StaticResource ArchiveListItemStyle}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Auto">

                        <ListBox.ItemTemplate>

                            <DataTemplate>

                                <Border
                                    Margin="0,2"
                                    Padding="12,10"
                                    Background="{StaticResource Surface.Background}"
                                    CornerRadius="5">

                                    <Grid>

                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock
                                                Text="{Binding Subject}"
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                Foreground="{StaticResource Text.Primary}"
                                                TextTrimming="CharacterEllipsis" />

                                            <TextBlock
                                                Grid.Column="1"
                                                Margin="16,0,0,0"
                                                Text="{Binding MessageDateUtc, StringFormat={}{0:dd.MM.yyyy HH:mm}}"
                                                FontSize="11"
                                                Foreground="{StaticResource Text.Secondary}" />

                                        </Grid>

                                        <TextBlock
                                            Grid.Row="1"
                                            Margin="0,5,0,0"
                                            FontSize="11"
                                            Foreground="{StaticResource Text.Secondary}"
                                            TextTrimming="CharacterEllipsis">

                                            <Run Text="{Binding SenderName}" />
                                            <Run Text="  " />
                                            <Run Text="{Binding SenderAddress}" />

                                        </TextBlock>

                                        <Grid
                                            Grid.Row="2"
                                            Margin="0,5,0,0">

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock
                                                Text="{Binding SourceFolderId}"
                                                FontSize="10"
                                                Foreground="{StaticResource Text.Muted}"
                                                TextTrimming="CharacterEllipsis" />

                                            <TextBlock
                                                Grid.Column="1"
                                                Margin="12,0,0,0"
                                                Text="{Binding LocalFileState}"
                                                FontSize="10"
                                                Foreground="{StaticResource Text.Muted}" />

                                        </Grid>

                                    </Grid>

                                </Border>

                            </DataTemplate>

                        </ListBox.ItemTemplate>

                    </ListBox>

                </Grid>

            </Border>

        </Grid>

        <!-- LADE-/FEHLERSTATUS -->

        <Grid
            x:Name="ArchiveStatusGrid"
            Grid.Row="2">

            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

                <TextBlock
                    x:Name="ArchiveStatusTitleText"
                    Text="Lokales Archiv wird geladen …"
                    HorizontalAlignment="Center"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource Text.Primary}" />

                <TextBlock
                    x:Name="ArchiveStatusDetailText"
                    Margin="0,8,0,0"
                    MaxWidth="600"
                    Text="Archivdatenbank und lokale Archivdateien werden geprüft."
                    HorizontalAlignment="Center"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    FontSize="12"
                    Foreground="{StaticResource Text.Secondary}" />

            </StackPanel>

        </Grid>

        <!-- FUSS -->

        <Border
            Grid.Row="3"
            Margin="0,20,0,0"
            Padding="0,18,0,0"
            BorderBrush="{StaticResource Border.Default}"
            BorderThickness="0,1,0,0">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    Text="Das Archiv liegt ausschließlich lokal auf diesem Computer und sollte regelmäßig gesichert werden."
                    Margin="0,0,20,0"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Foreground="{StaticResource Text.Secondary}"
                    TextWrapping="Wrap" />

                <Button
                    x:Name="OpenArchiveFolderButton"
                    Grid.Column="1"
                    Width="155"
                    Height="38"
                    Margin="0,0,10,0"
                    Content="Ordner öffnen"
                    Cursor="Hand"
                    IsEnabled="False"
                    Click="OpenArchiveFolderButton_OnClick" />

                <Button
                    Grid.Column="2"
                    Width="110"
                    Height="38"
                    Content="Schließen"
                    Cursor="Hand"
                    IsCancel="True"
                    Style="{StaticResource Button.Primary}"
                    Click="CloseButton_OnClick" />

            </Grid>

        </Border>

    </Grid>

</Window>