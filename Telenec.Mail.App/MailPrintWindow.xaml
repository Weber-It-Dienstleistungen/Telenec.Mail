<Window x:Class="Telenec.Mail.App.MailPrintWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="E-Mail drucken"
        Width="920"
        Height="760"
        MinWidth="700"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Surface.Background}"
        Foreground="{StaticResource Text.Primary}"
        FontFamily="{StaticResource Typography.FontFamily}"
        Loaded="MailPrintWindow_OnLoaded"
        Closed="MailPrintWindow_OnClosed">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="1" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- KOPF -->

        <Border
            Grid.Row="0"
            Padding="24,18"
            Background="{StaticResource Surface.Card}"
            BorderBrush="{StaticResource Border.Subtle}"
            BorderThickness="0,0,0,1">

            <StackPanel>

                <TextBlock
                    Text="Druckvorschau"
                    FontSize="21"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource Text.Primary}" />

                <TextBlock
                    Margin="0,4,0,0"
                    Text="Die Nachricht wird so für den Druck vorbereitet."
                    FontSize="12"
                    Foreground="{StaticResource Text.Secondary}" />

            </StackPanel>

        </Border>

        <!-- VORSCHAU -->

        <Border
            Grid.Row="1"
            Margin="20"
            Background="White"
            BorderBrush="{StaticResource Border.Default}"
            BorderThickness="1"
            CornerRadius="6">

            <Grid>

                <wv2:WebView2
                    x:Name="PrintWebView" />

                <Border
                    x:Name="LoadingOverlay"
                    Background="White">

                    <StackPanel
                        Width="280"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                        <ProgressBar
                            Height="4"
                            IsIndeterminate="True" />

                        <TextBlock
                            Margin="0,14,0,0"
                            Text="Druckvorschau wird vorbereitet …"
                            FontSize="13"
                            Foreground="{StaticResource Text.Secondary}"
                            HorizontalAlignment="Center" />

                    </StackPanel>

                </Border>

            </Grid>

        </Border>

        <Border
            Grid.Row="2"
            Background="{StaticResource Border.Subtle}" />

        <!-- AKTIONEN -->

        <Border
            Grid.Row="3"
            Padding="20,16"
            Background="{StaticResource Surface.Card}">

            <StackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal">

                <Button
                    Width="110"
                    Height="38"
                    Margin="0,0,10,0"
                    Content="Schließen"
                    Cursor="Hand"
                    Click="CloseButton_OnClick" />

                <Button
                    x:Name="PrintButton"
                    Width="120"
                    Height="38"
                    Content="Drucken"
                    Cursor="Hand"
                    IsEnabled="False"
                    Style="{StaticResource Button.Primary}"
                    Click="PrintButton_OnClick" />

            </StackPanel>

        </Border>

    </Grid>

</Window>