<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- =========================================================
         Telenec Mail – zentrale Designressourcen
         Die Markenfarben sind vorläufig und können später
         zentral an die offiziellen CI-Farben angepasst werden.
         ========================================================= -->

    <!-- Brand Colors -->

    <Color x:Key="Brand.Primary.Color">#0078C8</Color>
    <Color x:Key="Brand.PrimaryHover.Color">#0068AD</Color>
    <Color x:Key="Brand.PrimaryLight.Color">#E8F4FC</Color>
    <Color x:Key="Brand.Dark.Color">#24272B</Color>

    <!-- Navigation Colors -->

    <Color x:Key="Navigation.Background.Color">#24272B</Color>
    <Color x:Key="Navigation.Hover.Color">#2A3239</Color>
    <Color x:Key="Navigation.Selected.Color">#303B45</Color>
    <Color x:Key="Navigation.Text.Color">#FFFFFF</Color>
    <Color x:Key="Navigation.TextSecondary.Color">#AEB7C0</Color>

    <!-- Surface Colors -->

    <Color x:Key="Surface.Background.Color">#F3F5F7</Color>
    <Color x:Key="Surface.Card.Color">#FFFFFF</Color>
    <Color x:Key="Surface.Hover.Color">#F6F8FA</Color>
    <Color x:Key="Surface.Selected.Color">#EAF5FC</Color>

    <!-- Text Colors -->

    <Color x:Key="Text.Primary.Color">#1F2328</Color>
    <Color x:Key="Text.Secondary.Color">#66707A</Color>
    <Color x:Key="Text.Muted.Color">#8C959F</Color>

    <!-- Border Colors -->

    <Color x:Key="Border.Default.Color">#D8DEE4</Color>
    <Color x:Key="Border.Subtle.Color">#E8EBEF</Color>

    <!-- Status Colors -->

    <Color x:Key="Status.Success.Color">#238636</Color>
    <Color x:Key="Status.Warning.Color">#B7791F</Color>
    <Color x:Key="Status.Error.Color">#CF222E</Color>
    <Color x:Key="Status.Information.Color">#0969DA</Color>

    <!-- =========================================================
         Semantic Brushes
         ========================================================= -->

    <SolidColorBrush
        x:Key="Brand.Primary"
        Color="{StaticResource Brand.Primary.Color}" />

    <SolidColorBrush
        x:Key="Brand.PrimaryHover"
        Color="{StaticResource Brand.PrimaryHover.Color}" />

    <SolidColorBrush
        x:Key="Brand.PrimaryLight"
        Color="{StaticResource Brand.PrimaryLight.Color}" />

    <SolidColorBrush
        x:Key="Brand.Dark"
        Color="{StaticResource Brand.Dark.Color}" />

    <SolidColorBrush
        x:Key="Navigation.Background"
        Color="{StaticResource Navigation.Background.Color}" />

    <SolidColorBrush
        x:Key="Navigation.Hover"
        Color="{StaticResource Navigation.Hover.Color}" />

    <SolidColorBrush
        x:Key="Navigation.Selected"
        Color="{StaticResource Navigation.Selected.Color}" />

    <SolidColorBrush
        x:Key="Navigation.Text"
        Color="{StaticResource Navigation.Text.Color}" />

    <SolidColorBrush
        x:Key="Navigation.TextSecondary"
        Color="{StaticResource Navigation.TextSecondary.Color}" />

    <SolidColorBrush
        x:Key="Surface.Background"
        Color="{StaticResource Surface.Background.Color}" />

    <SolidColorBrush
        x:Key="Surface.Card"
        Color="{StaticResource Surface.Card.Color}" />

    <SolidColorBrush
        x:Key="Surface.Hover"
        Color="{StaticResource Surface.Hover.Color}" />

    <SolidColorBrush
        x:Key="Surface.Selected"
        Color="{StaticResource Surface.Selected.Color}" />

    <SolidColorBrush
        x:Key="Text.Primary"
        Color="{StaticResource Text.Primary.Color}" />

    <SolidColorBrush
        x:Key="Text.Secondary"
        Color="{StaticResource Text.Secondary.Color}" />

    <SolidColorBrush
        x:Key="Text.Muted"
        Color="{StaticResource Text.Muted.Color}" />

    <SolidColorBrush
        x:Key="Border.Default"
        Color="{StaticResource Border.Default.Color}" />

    <SolidColorBrush
        x:Key="Border.Subtle"
        Color="{StaticResource Border.Subtle.Color}" />

    <SolidColorBrush
        x:Key="Status.Success"
        Color="{StaticResource Status.Success.Color}" />

    <SolidColorBrush
        x:Key="Status.Warning"
        Color="{StaticResource Status.Warning.Color}" />

    <SolidColorBrush
        x:Key="Status.Error"
        Color="{StaticResource Status.Error.Color}" />

    <SolidColorBrush
        x:Key="Status.Information"
        Color="{StaticResource Status.Information.Color}" />

    <!-- =========================================================
         Typography
         ========================================================= -->

    <FontFamily x:Key="Typography.FontFamily">Segoe UI Variable</FontFamily>

    <!-- =========================================================
         Primary Button
         ========================================================= -->

    <Style x:Key="Button.Primary"
           TargetType="Button">

        <Setter Property="Background"
                Value="{StaticResource Brand.Primary}" />

        <Setter Property="Foreground"
                Value="White" />

        <Setter Property="FontFamily"
                Value="{StaticResource Typography.FontFamily}" />

        <Setter Property="FontWeight"
                Value="SemiBold" />

        <Setter Property="Padding"
                Value="16,8" />

        <Setter Property="MinHeight"
                Value="36" />

        <Setter Property="BorderThickness"
                Value="0" />

        <Setter Property="Cursor"
                Value="Hand" />

        <Setter Property="Template">

            <Setter.Value>

                <ControlTemplate TargetType="Button">

                    <Border
                        x:Name="ButtonBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="6">

                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="{TemplateBinding Padding}" />

                    </Border>

                    <ControlTemplate.Triggers>

                        <Trigger Property="IsMouseOver"
                                 Value="True">

                            <Setter
                                TargetName="ButtonBorder"
                                Property="Background"
                                Value="{StaticResource Brand.PrimaryHover}" />

                        </Trigger>

                        <Trigger Property="IsEnabled"
                                 Value="False">

                            <Setter Property="Opacity"
                                    Value="0.55" />

                        </Trigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>

            </Setter.Value>

        </Setter>

    </Style>

    <!-- =========================================================
         Navigation
         ========================================================= -->

    <Style x:Key="Navigation.Item"
           TargetType="Border">

        <Setter Property="Height"
                Value="42" />

        <Setter Property="Margin"
                Value="12,2" />

        <Setter Property="Padding"
                Value="14,0" />

        <Setter Property="CornerRadius"
                Value="6" />

        <Setter Property="Background"
                Value="Transparent" />

    </Style>

    <Style
        x:Key="Navigation.Item.Selected"
        TargetType="Border"
        BasedOn="{StaticResource Navigation.Item}">

        <Setter Property="Background"
                Value="{StaticResource Navigation.Selected}" />

    </Style>

    <Style x:Key="Navigation.ItemText"
           TargetType="TextBlock">

        <Setter Property="Foreground"
                Value="{StaticResource Navigation.Text}" />

        <Setter Property="FontFamily"
                Value="{StaticResource Typography.FontFamily}" />

        <Setter Property="FontSize"
                Value="14" />

        <Setter Property="VerticalAlignment"
                Value="Center" />

    </Style>

    <!-- Interactive folder navigation -->

    <Style x:Key="Navigation.FolderList"
           TargetType="ListBox">

        <Setter Property="Background"
                Value="Transparent" />

        <Setter Property="BorderThickness"
                Value="0" />

        <Setter Property="Padding"
                Value="0" />

        <Setter Property="SelectionMode"
                Value="Single" />

        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility"
                Value="Disabled" />

        <Setter Property="ScrollViewer.VerticalScrollBarVisibility"
                Value="Disabled" />

    </Style>

    <Style x:Key="Navigation.FolderItem"
           TargetType="ListBoxItem">

        <Setter Property="Background"
                Value="Transparent" />

        <Setter Property="BorderThickness"
                Value="0" />

        <Setter Property="Padding"
                Value="0" />

        <Setter Property="Margin"
                Value="0" />

        <Setter Property="HorizontalContentAlignment"
                Value="Stretch" />

        <Setter Property="Cursor"
                Value="Hand" />

        <Setter Property="Template">

            <Setter.Value>

                <ControlTemplate TargetType="ListBoxItem">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border
                            x:Name="NavigationItemBorder"
                            Grid.Row="0"
                            Height="42"
                            Margin="12,2"
                            Padding="14,0"
                            CornerRadius="6"
                            Background="{TemplateBinding Background}">

                            <Grid>

                                <Border
                                    x:Name="SelectionIndicator"
                                    Width="3"
                                    Height="24"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    CornerRadius="2"
                                    Background="{StaticResource Brand.Primary}"
                                    Visibility="Collapsed" />

                                <ContentPresenter
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="Center" />

                            </Grid>

                        </Border>

                        <Border
                            x:Name="SectionSeparator"
                            Grid.Row="1"
                            Height="1"
                            Margin="24,14"
                            Background="{StaticResource Navigation.Selected}"
                            Visibility="Collapsed" />

                    </Grid>

                    <ControlTemplate.Triggers>

                        <Trigger Property="IsMouseOver"
                                 Value="True">

                            <Setter
                                TargetName="NavigationItemBorder"
                                Property="Background"
                                Value="{StaticResource Navigation.Hover}" />

                        </Trigger>

                        <Trigger Property="IsSelected"
                                 Value="True">

                            <Setter
                                TargetName="NavigationItemBorder"
                                Property="Background"
                                Value="{StaticResource Navigation.Selected}" />

                            <Setter
                                TargetName="SelectionIndicator"
                                Property="Visibility"
                                Value="Visible" />

                        </Trigger>

                        <DataTrigger
                            Binding="{Binding HasSeparatorAfter}"
                            Value="True">

                            <Setter
                                TargetName="SectionSeparator"
                                Property="Visibility"
                                Value="Visible" />

                        </DataTrigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>

            </Setter.Value>

        </Setter>

    </Style>

    <!-- =========================================================
         Mail list
         ========================================================= -->

    <Style x:Key="MailList.Item"
           TargetType="Border">

        <Setter Property="Background"
                Value="{StaticResource Surface.Card}" />

        <Setter Property="BorderBrush"
                Value="{StaticResource Border.Subtle}" />

        <Setter Property="BorderThickness"
                Value="0,0,0,1" />

        <Setter Property="Padding"
                Value="18,15" />

    </Style>

    <Style
        x:Key="MailList.Item.Selected"
        TargetType="Border"
        BasedOn="{StaticResource MailList.Item}">

        <Setter Property="Background"
                Value="{StaticResource Surface.Selected}" />

    </Style>

    <!-- Interactive mail list -->

    <Style x:Key="MailList.MessageList"
           TargetType="ListBox">

        <Setter Property="Background"
                Value="{StaticResource Surface.Card}" />

        <Setter Property="BorderThickness"
                Value="0" />

        <Setter Property="Padding"
                Value="0" />

        <Setter Property="SelectionMode"
                Value="Single" />

        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility"
                Value="Disabled" />

        <Setter Property="ScrollViewer.VerticalScrollBarVisibility"
                Value="Auto" />

    </Style>

    <Style x:Key="MailList.MessageItem"
           TargetType="ListBoxItem">

        <Setter Property="Background"
                Value="{StaticResource Surface.Card}" />

        <Setter Property="BorderBrush"
                Value="{StaticResource Border.Subtle}" />

        <Setter Property="BorderThickness"
                Value="0,0,0,1" />

        <Setter Property="Padding"
                Value="0" />

        <Setter Property="Margin"
                Value="0" />

        <Setter Property="HorizontalContentAlignment"
                Value="Stretch" />

        <Setter Property="Cursor"
                Value="Hand" />

        <Setter Property="Template">

            <Setter.Value>

                <ControlTemplate TargetType="ListBoxItem">

                    <Border
                        x:Name="MessageBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">

                        <Grid>

                            <Border
                                x:Name="SelectionIndicator"
                                Width="3"
                                HorizontalAlignment="Left"
                                Background="{StaticResource Brand.Primary}"
                                Visibility="Collapsed" />

                            <ContentPresenter
                                x:Name="MessageContent"
                                Margin="18,15"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center" />

                        </Grid>

                    </Border>

                    <ControlTemplate.Triggers>

                        <Trigger Property="IsMouseOver"
                                 Value="True">

                            <Setter
                                TargetName="MessageBorder"
                                Property="Background"
                                Value="{StaticResource Surface.Hover}" />

                        </Trigger>

                        <Trigger Property="IsSelected"
                                 Value="True">

                            <Setter
                                TargetName="MessageBorder"
                                Property="Background"
                                Value="{StaticResource Surface.Selected}" />

                            <Setter
                                TargetName="SelectionIndicator"
                                Property="Visibility"
                                Value="Visible" />

                            <Setter
                                TargetName="MessageContent"
                                Property="Margin"
                                Value="31,15,18,15" />

                        </Trigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>

            </Setter.Value>

        </Setter>

    </Style>

</ResourceDictionary>