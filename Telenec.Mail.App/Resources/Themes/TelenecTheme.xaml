<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- =========================================================
         Telenec Mail – zentrale Designressourcen
         Die Markenfarben sind vorläufig und können später
         zentral an die offiziellen CI-Farben angepasst werden.
         ========================================================= -->

    <!-- Brand Colors -->
    <Color x:Key="Brand.Primary.Color">#0078C8</Color>
    <Color x:Key="Brand.PrimaryHover.Color">#0068AD</Color>
    <Color x:Key="Brand.PrimaryLight.Color">#E8F4FC</Color>
    <Color x:Key="Brand.Dark.Color">#24272B</Color>

    <!-- Surface Colors -->
    <Color x:Key="Surface.Background.Color">#F3F5F7</Color>
    <Color x:Key="Surface.Card.Color">#FFFFFF</Color>

    <!-- Text Colors -->
    <Color x:Key="Text.Primary.Color">#1F2328</Color>
    <Color x:Key="Text.Secondary.Color">#66707A</Color>

    <!-- Border Colors -->
    <Color x:Key="Border.Default.Color">#D8DEE4</Color>

    <!-- Status Colors -->
    <Color x:Key="Status.Success.Color">#238636</Color>
    <Color x:Key="Status.Warning.Color">#B7791F</Color>
    <Color x:Key="Status.Error.Color">#CF222E</Color>
    <Color x:Key="Status.Information.Color">#0969DA</Color>

    <!-- Semantic Brushes -->
    <SolidColorBrush
        x:Key="Brand.Primary"
        Color="{StaticResource Brand.Primary.Color}" />

    <SolidColorBrush
        x:Key="Brand.PrimaryHover"
        Color="{StaticResource Brand.PrimaryHover.Color}" />

    <SolidColorBrush
        x:Key="Brand.PrimaryLight"
        Color="{StaticResource Brand.PrimaryLight.Color}" />

    <SolidColorBrush
        x:Key="Brand.Dark"
        Color="{StaticResource Brand.Dark.Color}" />

    <SolidColorBrush
        x:Key="Surface.Background"
        Color="{StaticResource Surface.Background.Color}" />

    <SolidColorBrush
        x:Key="Surface.Card"
        Color="{StaticResource Surface.Card.Color}" />

    <SolidColorBrush
        x:Key="Text.Primary"
        Color="{StaticResource Text.Primary.Color}" />

    <SolidColorBrush
        x:Key="Text.Secondary"
        Color="{StaticResource Text.Secondary.Color}" />

    <SolidColorBrush
        x:Key="Border.Default"
        Color="{StaticResource Border.Default.Color}" />

    <SolidColorBrush
        x:Key="Status.Success"
        Color="{StaticResource Status.Success.Color}" />

    <SolidColorBrush
        x:Key="Status.Warning"
        Color="{StaticResource Status.Warning.Color}" />

    <SolidColorBrush
        x:Key="Status.Error"
        Color="{StaticResource Status.Error.Color}" />

    <SolidColorBrush
        x:Key="Status.Information"
        Color="{StaticResource Status.Information.Color}" />

    <!-- Typography -->
    <FontFamily x:Key="Typography.FontFamily">Segoe UI Variable</FontFamily>

    <!-- Base Button Style -->
    <Style x:Key="Button.Primary" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Brand.Primary}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontFamily" Value="{StaticResource Typography.FontFamily}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="ButtonBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="6">

                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="{TemplateBinding Padding}" />
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter
                                TargetName="ButtonBorder"
                                Property="Background"
                                Value="{StaticResource Brand.PrimaryHover}" />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>